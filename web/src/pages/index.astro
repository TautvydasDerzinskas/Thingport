<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const plainClick = (event: MouseEvent) =>
    event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;

  // The poster follows the theme toggle (the inline script beside it set the first one).
  const darkPoster = document.querySelector<HTMLSourceElement>("[data-dark-poster]");
  if (darkPoster) {
    const follow = () => (darkPoster.media = document.documentElement.dataset.theme === "dark" ? "all" : "not all");
    follow();
    new MutationObserver(follow).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  }

  // The demo: the poster is a link to YouTube until it's pressed, then the player takes its place, already playing.
  for (const link of document.querySelectorAll<HTMLAnchorElement>("[data-video-embed]")) {
    const warm = () => {
      if (document.querySelector('link[data-warm="youtube"]')) return;
      const hint = document.createElement("link");
      hint.rel = "preconnect";
      hint.href = "https://www.youtube-nocookie.com";
      hint.dataset.warm = "youtube";
      document.head.append(hint);
    };
    link.addEventListener("pointerenter", warm, { once: true });
    link.addEventListener("focus", warm, { once: true });
    link.addEventListener("click", (event) => {
      if (!plainClick(event)) return;
      event.preventDefault();
      const player = document.createElement("iframe");
      player.src = link.dataset.videoEmbed!;
      player.title = link.dataset.videoTitle ?? "";
      player.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      player.allowFullscreen = true;
      player.referrerPolicy = "strict-origin-when-cross-origin";
      link.replaceWith(player);
      player.focus();
    });
  }

  // The Find screenshots: a strip that scrolls and snaps on its own; the arrows and dots only steer it.
  for (const carousel of document.querySelectorAll<HTMLElement>("[data-carousel]")) {
    const track = carousel.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const showDot = (index: number) => dots.forEach((dot, i) => dot.setAttribute("aria-current", String(i === index)));
    const atScroll = () => {
      const step = slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : 1;
      return Math.min(slides.length - 1, Math.max(0, Math.round(track.scrollLeft / step)));
    };
    // The slide last asked for: while the strip glides there, the arrows step on from it, not from where it is yet.
    let current = 0;
    let gliding = false;
    const go = (index: number) => {
      current = (index + slides.length) % slides.length;
      showDot(current);
      const left = slides[current].offsetLeft - slides[0].offsetLeft;
      if (Math.abs(track.scrollLeft - left) < 1) return;
      gliding = true;
      track.scrollTo({ left, behavior: reducedMotion.matches ? "auto" : "smooth" });
    };
    // When the strip stops, a glide or a swipe cut short, it settles on the slide it's at.
    const settled = () => {
      gliding = false;
      current = atScroll();
      showDot(current);
    };
    // The browser's own word that scrolling has finished; without it, a pause in the scroll events.
    const hasScrollEnd = "onscrollend" in window;
    if (hasScrollEnd) track.addEventListener("scrollend", settled);
    let settle: number | undefined;
    let queued = false;
    track.addEventListener(
      "scroll",
      () => {
        if (!hasScrollEnd) {
          window.clearTimeout(settle);
          settle = window.setTimeout(settled, 150);
        }
        if (gliding || queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          if (gliding) return;
          current = atScroll();
          showDot(current);
        });
      },
      { passive: true },
    );
    carousel.querySelector("[data-prev]")?.addEventListener("click", () => go(current - 1));
    carousel.querySelector("[data-next]")?.addEventListener("click", () => go(current + 1));
    dots.forEach((dot, i) => dot.addEventListener("click", () => go(i)));
    for (const control of carousel.querySelectorAll<HTMLElement>("[data-js]")) control.hidden = false;
    carousel.classList.add("ready");
  }

  // The tools: without JavaScript each icon links to its tool's page; with it, they're tabs over the panel below.
  const toolsRoot = document.querySelector<HTMLElement>("[data-tools]");
  if (toolsRoot) {
    const list = toolsRoot.querySelector<HTMLElement>("[data-tool-list]")!;
    const tabs = [...list.querySelectorAll<HTMLAnchorElement>("[data-tool-tab]")];
    const panels = tabs.map((tab) => document.getElementById(tab.dataset.toolTab!)!);
    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute("aria-selected", String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };
    list.setAttribute("role", "tablist");
    list.setAttribute("aria-label", "Tools");
    tabs.forEach((tab, i) => {
      tab.id = `${panels[i].id}-tab`;
      tab.setAttribute("role", "tab");
      tab.setAttribute("aria-controls", panels[i].id);
      panels[i].setAttribute("role", "tabpanel");
      panels[i].setAttribute("aria-labelledby", tab.id);
      panels[i].tabIndex = 0;
      tab.addEventListener("click", (event) => {
        if (!plainClick(event)) return;
        event.preventDefault();
        select(i);
      });
      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowRight: i + 1,
          ArrowDown: i + 1,
          ArrowLeft: i - 1,
          ArrowUp: i - 1,
          Home: 0,
          End: tabs.length - 1,
        };
        if (!(event.key in keys)) return;
        event.preventDefault();
        select((keys[event.key] + tabs.length) % tabs.length, true);
      });
    });
    select(0);

    for (const panel of panels) {
      const shots = [...panel.querySelectorAll<HTMLElement>("[data-shot]")];
      const dots = [...panel.querySelectorAll<HTMLButtonElement>("[data-shot-dot]")];
      dots.forEach((dot, n) =>
        dot.addEventListener("click", () => {
          shots.forEach((shot, i) => (shot.hidden = i !== n));
          dots.forEach((other, i) => other.setAttribute("aria-current", String(i === n)));
        }),
      );
      panel.querySelector<HTMLElement>("[data-shot-dots]")?.removeAttribute("hidden");
    }
  }
</script>

