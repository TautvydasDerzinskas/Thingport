---
import { Image, getImage } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { communityItems } from "../lib/community";
import { LINKS, PROVIDER_NAMES, SITE_NAME } from "../lib/site.mjs";
import { formatDate, url } from "../lib/url";
import grabCollection from "../../../extension/docs/screenshots/collection-makerworld.jpg";
import grabCollectionDark from "../../../extension/docs/screenshots/collection-makerworld-dark.jpg";
import models from "../../../frontend/src/assets/screenshots/light/04_models.png";
import modelsDark from "../../../frontend/src/assets/screenshots/dark/04_models.png";
import collections from "../../../frontend/src/assets/screenshots/light/09_collections.png";
import collectionsDark from "../../../frontend/src/assets/screenshots/dark/09_collections.png";
import toolsPage from "../../../frontend/src/assets/screenshots/light/31_tools.png";
import toolsPageDark from "../../../frontend/src/assets/screenshots/dark/31_tools.png";
import toolWindow from "../../../frontend/src/assets/screenshots/light/32_tool_window.png";
import toolWindowDark from "../../../frontend/src/assets/screenshots/dark/32_tool_window.png";
import collectionSync from "../../../frontend/src/assets/screenshots/light/36_collection_sync.png";
import collectionSyncDark from "../../../frontend/src/assets/screenshots/dark/36_collection_sync.png";
import aiCompare from "../../../frontend/src/assets/screenshots/light/39_ai_description_compare.png";
import aiCompareDark from "../../../frontend/src/assets/screenshots/dark/39_ai_description_compare.png";
import studio from "../../../frontend/src/assets/screenshots/light/41_studio.png";
import studioDark from "../../../frontend/src/assets/screenshots/dark/41_studio.png";
import partnerModel from "../../../frontend/src/assets/screenshots/light/44_partner_model.png";
import partnerModelDark from "../../../frontend/src/assets/screenshots/dark/44_partner_model.png";

const providerCount = PROVIDER_NAMES.length;
const otherSites = providerCount - 3;
const home = new URL(url(), Astro.site).href;
const absolute = (path: string) => new URL(path, Astro.site).href;

const description = `Free, self-hosted 3D model library. Import from MakerWorld, Printables, Thingiverse and ${otherSites} more sites, design parts with AI and share with friends.`;

// The hero's demo. Until it's played the poster is the app's own Models page, in the visitor's theme, so nothing loads
// from YouTube; then youtube-nocookie's player takes its place, which sets no cookies until the video plays.
const VIDEO = {
  id: "8g-JoWckL2Y",
  title: "Thingport 1.6.0 demo",
  start: 6,
  length: "8:37",
  spoken: "8 minutes 37 seconds",
  duration: "PT8M37S",
  uploaded: "2026-11-07T11:52:24-08:00",
};
const watchUrl = `https://www.youtube.com/watch?v=${VIDEO.id}&t=${VIDEO.start}s`;

// One poster in a <picture>, so a visitor downloads only their theme's; the script keeps it with the theme toggle.
const POSTER_SIZES = "(min-width: 68rem) 66rem, 100vw";
const POSTER_WIDTHS = [640, 960, 1280, 1600, 2000];
const posterLight = await getImage({ src: models, widths: POSTER_WIDTHS, format: "webp" });
const posterDark = await getImage({ src: modelsDark, widths: POSTER_WIDTHS, format: "webp" });
const embedUrl = `https://www.youtube-nocookie.com/embed/${VIDEO.id}?start=${VIDEO.start}&autoplay=1&rel=0`;

const FIND_SLIDES = [
  {
    light: grabCollection,
    dark: grabCollectionDark,
    caption: "Import a whole collection, and keep it in sync",
    alt: "Thingport Grab on a MakerWorld collection page, ready to import its models and keep the collection in sync",
  },
  {
    light: models,
    dark: modelsDark,
    caption: "Every model in one library, filtered your way",
    alt: "The Models page: imported models in a grid, with categories and filters",
  },
  {
    light: collections,
    dark: collectionsDark,
    caption: "Collections, your own and the ones you imported",
    alt: "The Collections page with collections of models",
  },
  {
    light: collectionSync,
    dark: collectionSyncDark,
    caption: "Synced collections bring in what's added later",
    alt: "A collection kept in sync with the site it came from",
  },
];

// The most visual first; a tool added later still shows, at the end, under its own name.
const TOOL_ORDER = [
  "multiboard-planner",
  "gridfinity-drawer",
  "skadis-planner",
  "keyring-generator",
  "qr-code-generator",
  "enclosure-generator",
  "print-cost-estimator",
  "makerworld-3mf-normalizer",
  "openscad-customizer",
];
const SHORT_NAMES: Record<string, string> = {
  "multiboard-planner": "Multiboard",
  "gridfinity-drawer": "Gridfinity",
  "skadis-planner": "Skadis",
  "keyring-generator": "Keyring",
  "qr-code-generator": "QR code",
  "enclosure-generator": "Enclosure",
  "print-cost-estimator": "Print cost",
  "makerworld-3mf-normalizer": "3MF normalizer",
  "openscad-customizer": "Script customizer",
};
const orderOf = (slug: string) => (TOOL_ORDER.includes(slug) ? TOOL_ORDER.indexOf(slug) : TOOL_ORDER.length);
const tools = (await communityItems("tools"))
  .filter((tool) => tool.screenshots.length > 0)
  .sort((a, b) => orderOf(a.slug) - orderOf(b.slug));

const OWN_TOOL_SHOTS = [
  { light: toolsPage, dark: toolsPageDark, caption: "The Tools page: install one, or write your own" },
  { light: toolWindow, dark: toolWindowDark, caption: "Every tool opens in a window of its own" },
];

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const license = "https://www.gnu.org/licenses/agpl-3.0.html";
const jsonLd = [
  {
    "@type": "SoftwareApplication",
    "@id": `${home}#app`,
    name: SITE_NAME,
    description,
    applicationCategory: "MultimediaApplication",
    applicationSubCategory: "3D model library",
    operatingSystem: "Linux, macOS, Windows (Docker)",
    url: home,
    downloadUrl: LINKS.github,
    installUrl: absolute(url("docs/install/")),
    license,
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    screenshot: [absolute(models.src), absolute(studio.src)],
    featureList: [
      `Import 3D models from ${providerCount} sites, MakerWorld, Printables and Thingiverse among them`,
      "Upload STL, 3MF, STEP and OBJ files, folders and ZIPs",
      "3D preview in the browser",
      "AI that sorts models into your categories and tidies their descriptions",
      "Studio: change models or design new parts with AI",
      "Tools and an OpenSCAD script customizer that generate models",
      "Connected Thingport instances to share models with friends, over ActivityPub",
      "REST API and MCP server",
    ],
    subjectOf: { "@id": `${home}#demo` },
  },
  {
    "@type": "VideoObject",
    "@id": `${home}#demo`,
    name: VIDEO.title,
    description: "A demo of Thingport, the free, self-hosted 3D model library for 3D printing.",
    thumbnailUrl: [
      `https://i.ytimg.com/vi/${VIDEO.id}/maxresdefault.jpg`,
      `https://i.ytimg.com/vi/${VIDEO.id}/hqdefault.jpg`,
    ],
    uploadDate: VIDEO.uploaded,
    duration: VIDEO.duration,
    embedUrl: `https://www.youtube.com/embed/${VIDEO.id}`,
    url: `https://www.youtube.com/watch?v=${VIDEO.id}`,
    inLanguage: "en",
    publisher: { "@id": `${home}#organization` },
  },
  {
    "@type": "SoftwareSourceCode",
    name: SITE_NAME,
    codeRepository: LINKS.github,
    programmingLanguage: ["TypeScript"],
    license,
  },
];

const arrowLeft = "M15 5l-7 7 7 7";
const arrowRight = "M9 5l7 7-7 7";
---

<BaseLayout title="Thingport: Self-hosted 3D model library for 3D printing" description={description} jsonLd={jsonLd}>
  <div class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-inner">
        <h1 id="hero-title">
          <span class="kicker">Free, open-source, self-hosted 3D model library</span>
          Find it. <span class="accent">Keep it.</span> Make it. Share it.
        </h1>
        <p class="lead">
          Thingport imports 3D models from MakerWorld, Printables, Thingiverse and {otherSites} other sites into your own
          library, helps you change them or even design new ones with AI, and makes sharing them with friends easy.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary btn-lg" href={url("docs/install/")}>Install Thingport <Icon name="arrow" /></a>
          <p class="muted"><code>docker compose up -d</code> on any machine or NAS</p>
        </div>
      </div>

      <div class="container">
        <div class="demo" id="demo">
          <a
            class="demo-play"
            href={watchUrl}
            data-video-embed={embedUrl}
            data-video-title={VIDEO.title}
            aria-label={`Play the video: ${VIDEO.title}, ${VIDEO.spoken}`}
          >
            <picture>
              <source
                media="(prefers-color-scheme: dark)"
                srcset={posterDark.srcSet.attribute}
                sizes={POSTER_SIZES}
                type="image/webp"
                data-dark-poster
              />
              <img
                src={posterLight.src}
                srcset={posterLight.srcSet.attribute}
                sizes={POSTER_SIZES}
                width={models.width}
                height={models.height}
                alt=""
                loading="eager"
                fetchpriority="high"
                decoding="async"
              />
            </picture>
            <span class="play" aria-hidden="true">
              <svg width="40" height="40" viewBox="0 0 24 24"
                ><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg
              >
            </span>
            <span class="demo-chip" aria-hidden="true">{VIDEO.title}<span>{VIDEO.length}</span></span>
          </a>
        </div>
        <script is:inline>
          // Before the page's script loads, so a theme the visitor saved, apart from the system's, shows its poster.
          document.querySelector("[data-dark-poster]").media =
            document.documentElement.dataset.theme === "dark" ? "all" : "not all";
        </script>
        <p class="demo-watch"><a href={watchUrl}>Watch on YouTube <Icon name="arrow" size={14} /></a></p>
      </div>

      <div class="container">
        <ol class="flow" aria-label="How Thingport works">
          <li>
            <a class="flow-card" href="#find">
              <span class="flow-no">01 · Find</span>
              <span class="chips">
                <span class="chip">MakerWorld</span>
                <span class="chip">Printables</span>
                <span class="chip">Thingiverse</span>
                <span class="chip more">+{otherSites}</span>
              </span>
              <span class="flow-text">Import from {providerCount} sites, or your own files</span>
            </a>
          </li>
          <li>
            <a class="flow-card keep" href="#keep">
              <span class="flow-no">02 · Keep</span>
              <span class="mini">
                <span class="row"><span class="name">Gridfinity bin</span><span class="tag">Storage · AI</span></span>
                <span class="row"><span class="name">Cable clip</span><span class="tag">Desk · AI</span></span>
              </span>
              <span class="flow-text">A real copy, sorted for you by AI</span>
            </a>
          </li>
          <li>
            <a class="flow-card" href="#make">
              <span class="flow-no">03 · Make</span>
              <span class="flow-thumb">
                <Image class="only-light" src={studio} alt="" widths={[320, 640]} sizes="16rem" />
                <Image class="only-dark" src={studioDark} alt="" widths={[320, 640]} sizes="16rem" />
              </span>
              <span class="flow-text">Change it, or describe a new part</span>
            </a>
          </li>
          <li>
            <a class="flow-card" href="#share">
              <span class="flow-no">04 · Share</span>
              <span class="hosts">
                <span>home.lan</span>
                <svg width="24" height="14" viewBox="0 0 28 14" fill="none" aria-hidden="true">
                  <path
                    d="M2 4h22m-4-3l4 3-4 3M26 10H4m4-3l-4 3 4 3"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
                <span>workshop.lan</span>
              </span>
              <span class="flow-text">With friends on their own Thingport instance</span>
            </a>
          </li>
        </ol>
      </div>
    </section>

    <section id="find" class="section top-rule" aria-labelledby="find-title">
      <div class="container feature-row">
        <div class="feature-text">
          <p class="step-num" aria-hidden="true">01</p>
          <h2 id="find-title">Import 3D models from MakerWorld, Printables, Thingiverse and {otherSites} more sites</h2>
          <p>
            Bring in a whole collection or your likes at once with the <a href={url("docs/grab/")}>Thingport Grab</a> browser
            extension, keep them in sync, or paste a single link. Each model comes with its files, print profiles, photos,
            description, tags and author.
          </p>
          <p>
            Already have a folder of STL, 3MF, STEP and OBJ files? <a href={url("docs/guides/existing-library/")}
              >Upload folders and ZIPs</a
            >, or drop them in a watched folder.
          </p>
          <a class="text-link" href={url("docs/providers/")}
            >Compare all {providerCount} providers <Icon name="arrow" size={16} /></a
          >
        </div>
        <div class="feature-media carousel" data-carousel>
          <ul class="slides" data-track tabindex="0" aria-label="Importing and browsing models, in screenshots">
            {
              FIND_SLIDES.map((slide) => (
                <li class="slide">
                  <figure>
                    <div class="frame">
                      <Image
                        class="only-light"
                        src={slide.light}
                        alt={slide.alt}
                        widths={[640, 960, 1280]}
                        sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
                      />
                      <Image
                        class="only-dark"
                        src={slide.dark}
                        alt={slide.alt}
                        widths={[640, 960, 1280]}
                        sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
                      />
                    </div>
                    <figcaption>{slide.caption}</figcaption>
                  </figure>
                </li>
              ))
            }
          </ul>
          <div class="car-arrows" data-js hidden>
            <button type="button" class="car-btn prev" data-prev aria-label="Previous screenshot">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={arrowLeft}></path></svg>
            </button>
            <button type="button" class="car-btn next" data-next aria-label="Next screenshot">
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path d={arrowRight}></path></svg>
            </button>
          </div>
          <div class="dots" data-js hidden>
            {
              FIND_SLIDES.map((slide, i) => (
                <button
                  type="button"
                  data-dot
                  aria-label={`Show screenshot ${i + 1}: ${slide.caption}`}
                  aria-current={i === 0 ? "true" : "false"}
                >
                  <span />
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section id="keep" class="section alt" aria-labelledby="keep-title">
      <div class="container feature-row reverse">
        <div class="feature-text">
          <p class="step-num" aria-hidden="true">02</p>
          <h2 id="keep-title">Keep a 3D model library on your own server, sorted by AI</h2>
          <p>
            Every model is a real copy on your disk, kept even if the site removes it. Preview STL, 3MF, STEP and OBJ
            files in 3D in the browser, open them straight in your slicer, and find anything again with categories,
            collections, tags and search.
          </p>
          <p>
            Turn on AI and new imports are sorted into your own categories, and messy descriptions are tidied and
            translated into English. Run the model on your own hardware with Ollama, LM Studio or vLLM, or use a cloud
            API such as OpenAI, Gemini or Claude.
          </p>
          <a class="text-link" href={url("docs/guides/ai/")}>Set up AI <Icon name="arrow" size={16} /></a>
        </div>
        <figure class="feature-media shot">
          <Image
            class="only-light"
            src={aiCompare}
            alt="A model description before and after AI clean-up and translation into English, side by side, with Revert"
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
          />
          <Image
            class="only-dark"
            src={aiCompareDark}
            alt="A model description before and after AI clean-up and translation into English, side by side, with Revert"
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
          />
        </figure>
      </div>
    </section>

    <section id="make" class="section" aria-labelledby="make-title">
      <div class="container">
        <div class="make-head">
          <div>
            <p class="step-num" aria-hidden="true">03</p>
            <h2 id="make-title">Change models or design new parts with AI in Studio</h2>
          </div>
          <div>
            <p>
              Describe a part, or a change to a model you kept, and Studio's AI designs it step by step, checks it for
              printing and saves it to your library. Every step is a CAD command you can take yourself, and the same
              commands are tools for your assistant over MCP.
            </p>
            <a class="text-link" href={url("docs/guides/studio/")}>Read about Studio <Icon name="arrow" size={16} /></a>
          </div>
        </div>
        <figure class="shot make-shot">
          <Image
            class="only-light"
            src={studio}
            alt="Thingport Studio with a desk organiser the AI designed in 14 steps, and the Ask AI conversation beside it"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 72rem) 70rem, 100vw"
          />
          <Image
            class="only-dark"
            src={studioDark}
            alt="Thingport Studio with a desk organiser the AI designed in 14 steps, and the Ask AI conversation beside it"
            widths={[640, 960, 1280, 1600]}
            sizes="(min-width: 72rem) 70rem, 100vw"
          />
        </figure>
      </div>
    </section>

    <section id="share" class="section alt" aria-labelledby="share-title">
      <div class="container feature-row">
        <div class="feature-text">
          <p class="step-num" aria-hidden="true">04</p>
          <h2 id="share-title">Share models with friends on their own Thingport instance</h2>
          <p>
            Connect your Thingport instance with a friend's, your makerspace's or the one at work. Their people and
            models appear on your Explore, you can chat across instances, and Copy to my library keeps a model even if
            they delete theirs.
          </p>
          <p>
            Connected instances talk ActivityPub, the protocol behind the fediverse, but only with Thingport instances
            an admin approved. Nothing private leaves.
          </p>
          <a class="text-link" href={url("docs/guides/connected-instances/")}
            >Connect Thingport instances <Icon name="arrow" size={16} /></a
          >
        </div>
        <figure class="feature-media shot">
          <Image
            class="only-light"
            src={partnerModel}
            alt="A model from a connected Thingport instance, opened here, with Copy to my library"
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
          />
          <Image
            class="only-dark"
            src={partnerModelDark}
            alt="A model from a connected Thingport instance, opened here, with Copy to my library"
            widths={[640, 960, 1280]}
            sizes="(min-width: 72rem) 39rem, (min-width: 60rem) 55vw, 100vw"
          />
        </figure>
      </div>
    </section>

    <section id="tools" class="section" aria-labelledby="tools-title">
      <div class="container">
        <div class="section-head center">
          <span class="eyebrow">Tools</span>
          <h2 id="tools-title">Generate models on the fly with tools and OpenSCAD scripts</h2>
          <p>
            Small apps that open in a window of their own and save what they make straight into your library. Pick one
            to see it.
          </p>
        </div>
        <div class="tools" data-tools>
          <div class="tool-tiles" data-tool-list>
            {
              tools.map((tool) => (
                <a class="tool-tile" href={tool.href} data-tool-tab={`tool-${tool.slug}`} aria-label={tool.name}>
                  {tool.icon ? <img src={tool.icon} alt="" width="48" height="48" /> : <Icon name="wrench" size={32} />}
                  <span>{SHORT_NAMES[tool.slug] ?? tool.name}</span>
                </a>
              ))
            }
            <a
              class="tool-tile"
              href={url("docs/developers/first-tool/")}
              data-tool-tab="tool-your-own"
              aria-label="Your own tool"
            >
              <svg class="own-icon" width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                <rect
                  x="5"
                  y="5"
                  width="38"
                  height="38"
                  rx="9"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-dasharray="5 4"></rect>
                <path d="M24 15v18M15 24h18" stroke="currentColor" stroke-width="3" stroke-linecap="round"></path>
              </svg>
              <span>Your own</span>
            </a>
          </div>

          {
            tools.map((tool, i) => (
              <div class="tool-panel" id={`tool-${tool.slug}`} hidden={i !== 0}>
                <div class="tool-shots">
                  {tool.screenshots.map((shot, j) => (
                    <figure data-shot hidden={j !== 0}>
                      <div class="frame">
                        <img
                          src={shot.src}
                          alt={shot.caption ?? `${tool.name}, screenshot ${j + 1} of ${tool.screenshots.length}`}
                          width={shot.width}
                          height={shot.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                      {shot.caption && <figcaption>{shot.caption}</figcaption>}
                    </figure>
                  ))}
                  {tool.screenshots.length > 1 && (
                    <div class="dots" data-shot-dots hidden>
                      {tool.screenshots.map((_, j) => (
                        <button
                          type="button"
                          data-shot-dot
                          aria-label={`Show ${tool.name} screenshot ${j + 1} of ${tool.screenshots.length}`}
                          aria-current={j === 0 ? "true" : "false"}
                        >
                          <span />
                        </button>
                      ))}
                    </div>
                  )}
                </div>
                <div class="tool-about">
                  <div class="tool-name">
                    {tool.icon ? (
                      <img src={tool.icon} alt="" width="40" height="40" />
                    ) : (
                      <Icon name="wrench" size={28} />
                    )}
                    <h3>{tool.name}</h3>
                  </div>
                  <p>{tool.description}</p>
                  <a class="text-link" href={tool.href}>
                    More about the {tool.name} <Icon name="arrow" size={16} />
                  </a>
                </div>
              </div>
            ))
          }
          <div class="tool-panel" id="tool-your-own" hidden>
            <div class="tool-shots">
              {
                OWN_TOOL_SHOTS.map((shot, j) => (
                  <figure data-shot hidden={j !== 0}>
                    <div class="frame">
                      <Image
                        class="only-light"
                        src={shot.light}
                        alt={shot.caption}
                        widths={[640, 960, 1280]}
                        sizes="(min-width: 72rem) 44rem, 100vw"
                      />
                      <Image
                        class="only-dark"
                        src={shot.dark}
                        alt={shot.caption}
                        widths={[640, 960, 1280]}
                        sizes="(min-width: 72rem) 44rem, 100vw"
                      />
                    </div>
                    <figcaption>{shot.caption}</figcaption>
                  </figure>
                ))
              }
              <div class="dots" data-shot-dots hidden>
                {
                  OWN_TOOL_SHOTS.map((_, j) => (
                    <button
                      type="button"
                      data-shot-dot
                      aria-label={`Show screenshot ${j + 1} of ${OWN_TOOL_SHOTS.length}`}
                      aria-current={j === 0 ? "true" : "false"}
                    >
                      <span />
                    </button>
                  ))
                }
              </div>
            </div>
            <div class="tool-about">
              <div class="tool-name">
                <svg class="own-icon" width="40" height="40" viewBox="0 0 48 48" fill="none" aria-hidden="true">
