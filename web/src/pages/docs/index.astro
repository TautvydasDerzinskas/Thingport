---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import Icon from "../../components/Icon.astro";
import { PROVIDER_LOGOS } from "../../components/docs/providerLogos";
import { PROVIDER_DOCS } from "../../lib/providers.generated.mjs";
import { BRANCH, DOCS, DOCS_GROUPS, REPO_URL } from "../../lib/site.mjs";
import { url } from "../../lib/url";

/** A docs page's URL. A page that was renamed fails the build, rather than leaving a link to nowhere here. */
const docsUrl = (slug: string) => {
  if (!DOCS.some((d) => d.slug === slug)) throw new Error(`The docs home links to docs/${slug}/, which isn't in DOCS`);
  return url(`docs/${slug}/`);
};

const STEPS = [
  { title: "Install", text: "Docker Compose, Unraid, TrueNAS SCALE or CasaOS", href: docsUrl("install") },
  { title: "Connect providers", text: "The sign-ins and keys each site needs", href: docsUrl("providers") },
  { title: "Add Thingport Grab", text: "Import from model pages in Chrome, Edge or Firefox", href: docsUrl("grab") },
  {
    title: "Bring your library",
    text: "Upload files and folders, or a consume folder",
    href: docsUrl("guides/existing-library"),
  },
];

// The steps and the logos already lead into Getting started and Providers.
const TOPICS = DOCS_GROUPS.filter(({ group }) => group !== "Getting started" && group !== "Providers").map(
  ({ group, docs, count }) => {
    // A fifth page takes no more room than a "1 more" would.
    const shown = docs.length > 5 ? docs.slice(0, 4) : docs;
    return { group, count, shown, more: docs.slice(shown.length) };
  },
);
---

<StarlightPage
  frontmatter={{
    title: "Thingport docs",
    description:
      "Install Thingport with Docker Compose, on Unraid, TrueNAS SCALE or CasaOS, connect MakerWorld, Thingiverse and the other sites you import from, bring in your existing model library, and set up the Thingport Grab and Bridge companion apps.",
    head: [{ tag: "title", content: "Documentation · Thingport" }],
    tableOfContents: false,
    // A page of links: as a search result it would only crowd out the pages it links to.
    pagefind: false,
    editUrl: `${REPO_URL}/blob/${BRANCH}/web/src/pages/docs/index.astro`,
  }}
>
  <div class="home not-content">
    <p class="lead">Install it, connect the sites you use, and bring your library along.</p>

    <button class="search" type="button" data-docs-search disabled aria-keyshortcuts="Control+K">
      <Icon name="magnifier" size={20} />
      <span class="search-label">Search the docs, the blog and the feature tour</span>
      <kbd class="search-keys" aria-hidden="true" hidden><kbd data-modifier>Ctrl</kbd><kbd>K</kbd></kbd>
    </button>
    <script is:inline>
      // The shortcut as Starlight's own search button shows it: ⌘ on Apple devices, set before it first shows.
      (() => {
        const button = document.querySelector("[data-docs-search]");
        const keys = button && button.querySelector(".search-keys");
        if (!keys) return;
        if (/(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
          keys.querySelector("[data-modifier]").textContent = "⌘";
          button.setAttribute("aria-keyshortcuts", "Meta+K");
        }
        keys.hidden = false;
      })();
    </script>
    <script>
      // Opens the search dialog of the header's search (Starlight's), the only one on the page.
      const button = document.querySelector<HTMLButtonElement>("[data-docs-search]");
      customElements.whenDefined("site-search").then(() => {
        const open = document.querySelector<HTMLButtonElement>("site-search button[data-open-modal]");
        if (!button || !open) return;
        button.disabled = false;
        button.addEventListener("click", (event) => {
          // The dialog closes on a click outside it, and this click would reach it as it bubbles up.
          event.stopPropagation();
          open.click();
        });
      });
    </script>

    <section class="block">
      <h2 class="block-title">Start here</h2>
      <ol class="steps" role="list">
        {
          STEPS.map((step, i) => (
            <li class="step">
              <span class="step-number" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="step-title">
                <a href={step.href} aria-describedby={`start-step-${i + 1}`}>
                  {step.title}
                </a>
              </h3>
              <p class="step-text" id={`start-step-${i + 1}`}>
                {step.text}
              </p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="block">
      <div class="block-head">
        <h2 class="block-title">Import from {PROVIDER_DOCS.length} sites</h2>
        <a class="block-link" href={docsUrl("providers")}>
          All providers<span aria-hidden="true"> ›</span>
        </a>
      </div>
      <ul class="tiles" role="list">
        {
          PROVIDER_DOCS.map((d) => (
            <li>
              <a class="tile" href={url(`docs/${d.slug}/`)} aria-label={d.nav} data-name={d.nav}>
                <img src={PROVIDER_LOGOS[d.slug.slice("providers/".length)]} alt="" width="46" height="46" />
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block">
      <h2 class="block-title">Browse by topic</h2>
      <ul class="topics" role="list">
        {
          TOPICS.map(({ group, count, shown, more }) => (
            <li class="topic">
              <div class="topic-head">
                <h3 class="topic-title">{group}</h3>
                <span class="topic-count">
                  {count} {count === 1 ? "page" : "pages"}
                </span>
              </div>
              <ul class="links" role="list">
                {shown.map((d) => (
                  <li>
                    <a href={url(`docs/${d.slug}/`)}>{d.nav}</a>
                  </li>
                ))}
              </ul>
              {more.length > 0 && (
                <details class="more">
                  <summary>
                    <span class="caret" aria-hidden="true">
                      ›
                    </span>
                    <span class="when-closed">
                      {more.length} more<span class="sr-only"> {group} pages</span>
                    </span>
                    <span class="when-open">
                      Show fewer<span class="sr-only"> {group} pages</span>
                    </span>
                  </summary>
                  <ul class="links" role="list">
                    {more.map((d) => (
                      <li>
                        <a href={url(`docs/${d.slug}/`)}>{d.nav}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</StarlightPage>

<style>
  /* No table of contents beside this page, so it takes that room. */
  @media screen {
    :global(:root) {
      --sl-content-width: 57rem;
    }
  }

  .home {
    container-type: inline-size;
  }
  .lead {
    max-width: 60ch;
    color: var(--text);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    max-width: 35rem;
    height: 3rem;
    margin-top: 1.25rem;
    padding: 0 0.75rem 0 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
    color: var(--text-muted);
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .search:disabled {
    cursor: default;
  }
  .search:enabled:hover {
    border-color: var(--accent);
  }
  .search :global(svg) {
    flex: none;
  }
  .search-label {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-keys {
    display: inline-flex;
    gap: 0.3em;
    padding: 0.125rem 0.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
  }
  .search-keys kbd {
    font: inherit;
  }
  .search-keys[hidden] {
    display: none;
  }

  .block {
    margin-top: 2rem;
  }
  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }
  /* Headings start from .home, to outweigh the docs' own heading style (Starlight scopes with :where()). */
  .home .block-title {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .home .block-head .block-title {
    margin-bottom: 0;
  }
  .block-link {
    color: var(--link);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }
  .block-link:hover {
    text-decoration: underline;
  }

  .steps,
  .tiles,
  .topics,
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.875rem 1rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    transition: transform 0.15s ease-out;
  }
  .step:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .step-number {
    display: inline-grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    margin-bottom: 0.375rem;
    border-radius: 50%;
    background: var(--button);
    color: var(--button-text);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
  }
  /* Square in dark, as the app is. */
  :global(:root[data-theme="dark"]) .step-number {
    border-radius: 0;
  }
  .home .step-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.35;
  }
  .step-title a {
    color: var(--heading);
    text-decoration: none;
  }
  /* The whole card is the link, while only its title names it. */
  .step-title a::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: var(--radius);
  }
  .step-title a:focus-visible {
    outline: none;
  }
  .step-title a:focus-visible::after {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  .step-text {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .tiles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tile {
    position: relative;
    display: block;
    width: 2.875rem;
    height: 2.875rem;
    border-radius: 24%;
    transition: transform 0.15s ease-out;
  }
  .tile img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .tile:hover {
    transform: translateY(-2px);
  }
  /* The site's name, for anyone who doesn't know the logo (screen readers have the aria-label). It only exists while
     shown, so a name past the edge of a phone's screen can't widen the page. */
  .tile:is(:hover, :focus-visible)::after {
    content: attr(data-name);
    position: absolute;
    bottom: calc(100% + 0.375rem);
    left: 50%;
    z-index: 1;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    background: var(--heading);
    color: var(--panel);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    pointer-events: none;
    transform: translateX(-50%);
    animation: tip-in 0.15s ease-out;
  }
  @keyframes tip-in {
    from {
      opacity: 0;
      transform: translate(-50%, 0.25rem);
    }
  }

  .topics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .topic {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 0.875rem 1rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .topic-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .home .topic-title {
    margin: 0;
    color: var(--heading);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: normal;
    line-height: 1.35;
  }
  .topic-count {
    flex: none;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  /* Each link comes after its dot, and the strip where a line starts is clipped off: so a dot shows only between two
   * links on the same line, never dangling at a line's end. The clip leaves room for focus rings. */
  .links {
    --dot: 1.125em;
    display: flex;
    flex-wrap: wrap;
    row-gap: 0.25rem;
    margin-inline-start: calc(-1 * var(--dot));
    clip-path: inset(-4px -4px -4px calc(var(--dot) - 4px));
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .links li::before {
    content: "·";
    content: "·" / "";
    display: inline-block;
    width: var(--dot);
    color: var(--text-muted);
    text-align: center;
  }
  .links a {
    color: var(--link);
    text-decoration: none;
  }
  .links a:hover {
    text-decoration: underline;
  }
  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.5;
    list-style: none;
    cursor: pointer;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary:hover {
    color: var(--heading);
  }
  .caret {
    display: inline-block;
    transition: transform 0.15s ease-out;
  }
  .more[open] .caret {
    transform: rotate(90deg);
  }
  .when-open,
  .more[open] .when-closed {
    display: none;
  }
  .more[open] .when-open {
    display: inline;
  }
  .more[open] .links {
    margin-top: 0.375rem;
    animation: reveal 0.18s ease-out;
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }
  }

  @container (max-width: 44rem) {
    .steps,
    .topics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @container (max-width: 30rem) {
    .steps,
    .topics {
      grid-template-columns: minmax(0, 1fr);
    }
    /* One per row: the number beside the title and its line, not above them. */
    .step {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 0.75rem;
    }
    .step-number {
      grid-row: span 2;
      margin: 0;
    }
  }
  @media (max-width: 50rem) {
    .search-keys {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .tile,
    .caret {
      transition: none;
    }
    .step:hover,
    .tile:hover {
      transform: none;
    }
    .tile:is(:hover, :focus-visible)::after,
    .more[open] .links {
      animation: none;
    }
  }
</style>
