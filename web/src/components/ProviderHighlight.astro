---
// What sets a provider apart once it's in Thingport (the highlight in its docs.ts), under its page's title. Its brand
// colour only marks the card's edge and washes in from it: as text, some would be too pale on white and others too
// dark on the dark theme.
import Icon from "./Icon.astro";
import { curly, docsLink, providerPage } from "./providerPage";

type Props = {
  /** The provider's docsSlug, as in /docs/providers/<docsSlug>/. */
  slug: string;
};

const { slug } = Astro.props;
const { accent, highlight } = providerPage(slug);
const target = highlight.link ? await docsLink(highlight.link, `${slug}'s highlight`) : undefined;
---

<aside class="highlight" style={`--brand: ${accent}`} aria-labelledby="highlight-title">
  <span class="mark" aria-hidden="true"><Icon name="star" size={16} /></span>
  <div class="body">
    <p class="title" id="highlight-title">{curly(highlight.title)}</p>
    <p class="text">{curly(highlight.text)}</p>
    {
      target && (
        <a class="how" href={target.href}>
          <span>
            {target.page}
            {target.section && (
              <>
                <span class="sep" aria-hidden="true">
                  ›
                </span>
                <span class="sr-only">: </span>
                {target.section}
              </>
            )}
          </span>
          <Icon name="arrow" size={14} class="arrow" />
        </a>
      )
    }
  </div>
</aside>

<style>
  /* A neutral card with the brand on its edge and washing in from it: a tint all over would read as a warning in
   * the red, orange and yellow ones. */
  .highlight {
    --wash: 10%;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-top: 1.125rem;
    padding: 0.75rem 1rem 0.8125rem 1.0625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius);
    background:
      linear-gradient(to right, color-mix(in srgb, var(--brand) var(--wash), transparent), transparent 60%),
      var(--sl-color-bg);
    box-shadow: inset 4px 0 0 var(--brand);
  }
  :global(:root[data-theme="dark"]) .highlight {
    --wash: 14%;
  }

  .mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    margin-top: 0.0625rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--brand) 20%, var(--sl-color-bg));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 55%, transparent);
    color: var(--sl-color-white);
  }
  :global(:root[data-theme="dark"]) .mark {
    border-radius: 0;
  }

  .body {
    min-width: 0;
  }
  .title {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.4;
    text-wrap: balance;
  }
  .text {
    margin: 0.1875rem 0 0;
    color: var(--sl-color-text);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  .how {
    display: inline-block;
    margin-top: 0.375rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }
  .how:hover > span {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .how:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  /* Inline-block, so the link's underline leaves it out. In the link's colour: grey isn't legible enough on the
   * paler brands' wash in the dark theme. */
  .sep {
    display: inline-block;
    margin-inline: 0.3em;
    font-weight: 400;
  }
  /* At the end of the text, wherever it wraps. */
  .how :global(.arrow) {
    display: inline-block;
    margin-inline-start: 0.375rem;
    vertical-align: -0.125em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .how :global(.arrow) {
      transition: transform 0.15s ease-out;
    }
    .how:hover :global(.arrow) {
      transform: translateX(2px);
    }
  }
</style>
