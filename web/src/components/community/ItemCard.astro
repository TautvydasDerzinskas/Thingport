---
// A widget or tool in the gallery's grid, as the app lists it: icon, name, version and author, what it does and the
// services it reaches. The whole card links to its page.
import Icon from "../Icon.astro";
import ItemIcon from "./ItemIcon.astro";
import type { CommunityItem } from "../../lib/community";

type Props = { item: CommunityItem; level: 3 | 4 };
const { item, level } = Astro.props;
const Heading = `h${level}` as "h3" | "h4";
---

<li class="item">
  <div class="top">
    <ItemIcon src={item.icon} kind={item.kind} />
    <div class="titles">
      <Heading class="name"><a href={item.href}>{item.name}</a></Heading>
      <p class="by">v{item.version}{item.author && ` · ${item.author}`}</p>
    </div>
  </div>
  {item.description && <p class="description">{item.description}</p>}
  {
    item.hosts.length > 0 && (
      <p class="reaches">
        <Icon name="globe" size={14} />
        <span>
          <span class="visually-hidden">Reaches </span>
          {item.hosts.map((host, i) => (
            <>
              <span class="host">{host}</span>
              {i < item.hosts.length - 1 && ", "}
            </>
          ))}
        </span>
      </p>
    )
  }
</li>

<style>
  .item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    min-width: 0;
    padding: 1rem 1.125rem 1.125rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--panel);
    transition:
      border-color 0.15s,
      transform 0.15s ease-out;
  }
  .item:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .titles {
    min-width: 0;
  }
  .name {
    margin: 0;
    font-size: 1.0625rem;
    letter-spacing: normal;
    line-height: 1.35;
  }
  .name a {
    color: var(--heading);
    text-decoration: none;
  }
  /* The whole card is the link, while only its name names it. */
  .name a::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: var(--radius);
  }
  .name a:focus-visible {
    outline: none;
  }
  .name a:focus-visible::after {
    outline: 2px solid var(--link);
    outline-offset: 2px;
  }
  .item:hover .name a {
    color: var(--link);
  }
  .by,
  .description,
  .reaches {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .by {
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }
  .description {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }
  .reaches {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
  .reaches :global(svg) {
    flex: none;
    margin-top: 0.125rem;
  }
  /* A host breaks onto a line of its own rather than in two, unless it's wider than the card. */
  .host {
    display: inline-block;
  }
  @media (prefers-reduced-motion: reduce) {
    .item:hover {
      transform: none;
    }
  }
</style>
