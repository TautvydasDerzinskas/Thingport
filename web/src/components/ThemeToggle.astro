---
import Icon from "./Icon.astro";
---

<!-- Follows the system by default; the button cycles system, light, dark, remembered across the site, docs included. -->
<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label="Theme: system. Switch to light"
  title="Theme: system. Switch to light"
>
  <span data-mode="system"><Icon name="monitor" size={18} /></span>
  <span data-mode="light" hidden><Icon name="sun" size={18} /></span>
  <span data-mode="dark" hidden><Icon name="moon" size={18} /></span>
</button>

<script>
  import { THEME_COLORS, THEME_KEY } from "../lib/theme.mjs";

  const MODES = ["system", "light", "dark"] as const;
  type Mode = (typeof MODES)[number];

  const systemDark = matchMedia("(prefers-color-scheme: dark)");

  const storedMode = (): Mode => {
    try {
      const stored = localStorage.getItem(THEME_KEY);
      return stored === "light" || stored === "dark" ? stored : "system";
    } catch {
      return "system";
    }
  };

  // Held here, not read back from storage, so the button still cycles when storage is blocked.
  let mode = storedMode();

  const nextMode = () => MODES[(MODES.indexOf(mode) + 1) % MODES.length];

  const render = () => {
    const theme = mode === "system" ? (systemDark.matches ? "dark" : "light") : mode;
    document.documentElement.dataset.theme = theme;
    document.querySelector('meta[name="theme-color"]')?.setAttribute("content", THEME_COLORS[theme]);
    const label = `Theme: ${mode}. Switch to ${nextMode()}`;
    for (const button of document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")) {
      button.setAttribute("aria-label", label);
      button.title = label;
      for (const icon of button.querySelectorAll<HTMLElement>("[data-mode]")) icon.hidden = icon.dataset.mode !== mode;
    }
  };

  const cycle = () => {
    mode = nextMode();
    try {
      if (mode === "system") localStorage.removeItem(THEME_KEY);
      else localStorage.setItem(THEME_KEY, mode);
    } catch {
      /* storage blocked: the choice just won't persist */
    }
    render();
  };

  render();
  systemDark.addEventListener("change", render);
  for (const button of document.querySelectorAll("[data-theme-toggle]")) {
    button.addEventListener("click", cycle);
  }
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--panel);
    color: var(--heading);
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .theme-toggle:hover {
    border-color: var(--accent);
  }
  .theme-toggle span {
    display: inline-grid;
  }
  .theme-toggle span[hidden] {
    display: none;
  }
</style>
