---
// The same bar as the docs' (starlight/Header.astro): full width, so the logo, nav and buttons stay put between them.
import { url } from "../lib/url";
import GitHubStars from "./GitHubStars.astro";
import Logo from "./Logo.astro";
import SiteNav from "./SiteNav.astro";
import SiteSearch from "./SiteSearch.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={url()} aria-label="Thingport home"><Logo seasonal height={28} /></a>
    <SiteNav class="nav" />
    <div class="search"><SiteSearch /></div>
    <div class="actions">
      <GitHubStars />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--header-bg);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: calc(var(--header-height) - 1px);
    padding-inline: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  /* Placed and sized as the docs header's search, so the field doesn't move between the site and the docs. */
  .search {
    display: flex;
    flex: 0 1 18.75rem;
    min-width: 0;
    margin-left: auto;
  }
  /* Never squeezed: the search gives way instead (shrunk, the buttons' icons collapse to nothing). */
  .actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
  }
  /* As in the docs' header: until there's room for it, GitHub shows its icon and stars without its name. */
  @media (min-width: 50rem) and (max-width: 63.99rem) {
    .actions :global(.github-stars .name) {
      display: none;
    }
  }
  /* Phones: logo and buttons on the first row, as tall as the docs' header, and the nav as a second row. */
  @media (max-width: 49.99rem) {
    .bar {
      flex-wrap: wrap;
      gap: 0 1rem;
      padding-inline: 1rem;
    }
    .brand,
    .actions {
      min-height: calc(var(--header-height) - 1px);
    }
    .bar :global(.nav) {
      order: 3;
      width: 100%;
      margin-left: -0.75rem;
      padding-bottom: 0.5rem;
    }
    .search {
      flex: none;
    }
    .actions :global(.github-stars .name) {
      display: none;
    }
  }
</style>
