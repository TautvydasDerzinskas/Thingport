---
// The docs header is the site's (components/Header.astro), plus Starlight's search: the same height, logo, nav and
// actions in the same places. Starlight's PageFrame gives it its height, padding, background and border.
import Search from "@astrojs/starlight/components/Search.astro";
import { url } from "../../lib/url";
import GitHubStars from "../GitHubStars.astro";
import Logo from "../Logo.astro";
import SiteNav from "../SiteNav.astro";
import ThemeToggle from "../ThemeToggle.astro";
---

<div class="bar">
  <a class="brand" href={url()} aria-label="Thingport home"><Logo seasonal height={28} /></a>
  <SiteNav class="header-nav" />
  <div class="search print:hidden"><Search /></div>
  <div class="actions print:hidden">
    <GitHubStars />
    <ThemeToggle />
  </div>
</div>

<style>
  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 100%;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
  }
  .bar :global(.header-nav),
  .actions {
    display: none;
  }
  .search {
    display: flex;
    justify-content: flex-end;
    flex: 1 1 auto;
    min-width: 0;
  }

  /* Phones: the search is an icon button like the menu button beside it, which Starlight positions. */
  .search :global(button[data-open-modal]) {
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background-color: var(--panel);
    color: var(--heading);
    font-size: 1.125rem;
    transition:
      border-color 0.15s,
      color 0.15s;
  }
  .search :global(button[data-open-modal]:hover) {
    border-color: var(--accent);
  }

  /* Wider: the nav, GitHub and theme come out of the menu (MobileMenuFooter.astro), and the search is a field. */
  @media (min-width: 50rem) {
    .bar :global(.header-nav) {
      display: flex;
    }
    .actions {
      display: flex;
      flex: none;
      align-items: center;
      gap: 0.5rem;
    }
    .search {
      flex: 0 1 18.75rem;
      margin-inline-start: auto;
    }
    .search :global(button[data-open-modal]) {
      justify-content: flex-start;
      gap: 0.5rem;
      width: 100%;
      max-width: none;
      padding-inline: 0.75rem 0.375rem;
      background-color: var(--bg);
      color: var(--text-muted);
      font-size: var(--sl-text-sm);
    }
    .search :global(button[data-open-modal]:hover) {
      color: var(--heading);
    }
    /* As in the site's header: until there's room for it, GitHub shows its icon and stars without its name. */
    @media (max-width: 63.99rem) {
      .actions :global(.github-stars .name) {
        display: none;
      }
    }
    .search :global(button[data-open-modal] > svg) {
      flex: none;
      font-size: 1rem;
    }
    .search :global(button[data-open-modal] > span) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .search :global(button[data-open-modal] > kbd) {
      flex: none;
      align-items: center;
      gap: 0.25em;
      padding: 0.125rem 0.375rem;
      border: 1px solid var(--border);
      border-radius: calc(var(--radius-sm) * 0.75);
      background-color: var(--panel);
      color: var(--text-muted);
      font-family: var(--font-body);
      font-size: 0.6875rem;
      line-height: 1.4;
    }
  }
</style>
