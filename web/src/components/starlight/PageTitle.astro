---
// Starlight's own title (its <h1 id="_top">) with where the page sits: the docs' eyebrow on their home, "Docs / <group>"
// on every other page, and on a provider's page its logo beside its name and its highlight under it.
import Default from "@astrojs/starlight/components/PageTitle.astro";
import { providerOfRoute } from "../../lib/routeData";
import { DOCS } from "../../lib/site.mjs";
import { url } from "../../lib/url";
import ProviderHighlight from "../ProviderHighlight.astro";
import { PROVIDER_LOGOS } from "../docs/providerLogos";

const { id } = Astro.locals.starlightRoute;
const doc = DOCS.find((d) => `docs/${d.slug}` === id);
const provider = providerOfRoute(id);
---

<div class="page-title">
  {id === "docs" && <p class="eyebrow">Documentation</p>}
  {
    doc && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li>
            <a href={url("docs/")}>Docs</a>
          </li>
          <li>{provider ? <a href={url("docs/providers/")}>{doc.group}</a> : doc.group}</li>
        </ol>
      </nav>
    )
  }
  <div class="title">
    {provider && <img src={PROVIDER_LOGOS[provider]} alt="" width="40" height="40" />}
    <Default />
  </div>
  {provider && <ProviderHighlight slug={provider} />}
</div>

<style>
  .eyebrow {
    margin-bottom: 0.25rem;
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.5rem;
    padding: 0;
    list-style: none;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.4;
  }
  .crumbs li + li::before {
    content: "/";
    content: "/" / "";
    margin-inline-end: 0.375rem;
    color: var(--sl-color-gray-4);
  }
  .crumbs a {
    color: inherit;
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .title img {
    flex: none;
  }
  /* Centred on the logo, so no margin of its own above it. */
  .title :global(h1) {
    margin-top: 0;
  }
</style>
