---
// Near the foot of a provider's page: the comparison table of docs/PROVIDER_SETUP.md (scripts/sync-providers.mjs writes
// both from the same data), with this provider's row first.
import AnchorHeading from "@astrojs/starlight/components/AnchorHeading.astro";
import { PROVIDER_COMPARISON } from "../lib/providers.generated.mjs";
import { COMPARISON_HEADING } from "../lib/routeData";
import { url } from "../lib/url";
import Icon from "./Icon.astro";
import { PROVIDER_LOGOS as logos } from "./docs/providerLogos";
import { curly } from "./providerPage";

type Props = {
  /** The provider's docsSlug, as in /docs/providers/<docsSlug>/. */
  slug: string;
};

const { slug } = Astro.props;
const { columns, rows, notes } = PROVIDER_COMPARISON;
const current = rows.find((row) => row.docsSlug === slug)!;
const ordered = [current, ...rows.filter((row) => row !== current)];

const NEEDS: Record<string, string> = { required: "Required", recommended: "Recommended", optional: "Optional" };
const { id } = COMPARISON_HEADING;
const noteId = (note: number) => `${id}-note-${note}`;
---

<section class="compare" data-pagefind-ignore>
  <AnchorHeading level={2} id={id}>Compare with other providers</AnchorHeading>
  <div class="not-content">
    <div class="scroller" role="region" aria-labelledby={id} tabindex="0">
      <table>
        <thead>
          <tr>{columns.map((column) => <th scope="col">{column}</th>)}</tr>
        </thead>
        <tbody>
          {
            ordered.map((row) => (
              <tr class:list={{ current: row === current }}>
                <th scope="row">
                  {row === current ? (
                    <span class="provider">
                      <img src={logos[row.docsSlug]} alt="" width="20" height="20" />
                      <span>
                        {row.name}
                        <span class="here">This page</span>
                      </span>
                    </span>
                  ) : (
                    <a class="provider" href={url(`docs/providers/${row.docsSlug}/`)}>
                      <img src={logos[row.docsSlug]} alt="" width="20" height="20" />
                      <span>{row.name}</span>
                    </a>
                  )}
                </th>
                {row.cells.map((cell) => (
                  <td>
                    {cell.text !== undefined ? (
                      curly(cell.text)
                    ) : cell.need !== undefined && cell.need !== "none" ? (
                      <span class={`need ${cell.need}`}>{NEEDS[cell.need]}</span>
                    ) : cell.yes ? (
                      <>
                        <Icon name="check" size={16} class="yes" />
                        <span class="sr-only">Yes</span>
                      </>
                    ) : (
                      <>
                        <span class="no" aria-hidden="true">
                          –
                        </span>
                        <span class="sr-only">{cell.need ? "Not needed" : "No"}</span>
                      </>
                    )}
                    {cell.note && (
                      <sup>
                        <a href={`#${noteId(cell.note)}`} aria-label={`Note ${cell.note}`}>
                          {cell.note}
                        </a>
                      </sup>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ol class="notes">
      {notes.map((note, i) => <li id={noteId(i + 1)}>{curly(note)}</li>)}
    </ol>
  </div>
</section>

<style>
  .compare {
    /* The space Starlight gives a heading after other content, as this one would have in the Markdown. */
    margin-top: calc(1.5 * var(--sl-text-h2));
    --head-bg: var(--sl-color-gray-6);
    --line: var(--sl-color-hairline-light);
    --row-hover: color-mix(in srgb, var(--sl-color-gray-5) 35%, transparent);
  }
  :global(:root[data-theme="light"]) .compare {
    --head-bg: var(--sl-color-gray-7);
  }

  /* Narrow screens scroll the table in its box, the provider column staying put. */
  .scroller {
    /* Holds the cells' visually hidden text, which would otherwise widen the page. */
    position: relative;
    container-type: inline-size;
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--radius-sm);
    background: var(--sl-color-bg);
  }
  .scroller:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  /* A footnote that focus scrolls to comes into view clear of the provider column (about 8.5rem), not under it. Only
   * while one has focus: on a provider link, padding would scroll the table to some arbitrary point. */
  .scroller:has(sup a:focus) {
    scroll-padding-inline-start: 9rem;
  }

  table {
    display: table;
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--sl-text-xs);
    line-height: 1.35;
  }
  /* Sized so the whole table fits the content column of a wide screen. */
  th,
  td {
    padding: 0.5rem 0.4375rem;
    border-bottom: 1px solid var(--line);
    text-align: start;
    vertical-align: middle;
    white-space: nowrap;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    background: var(--head-bg);
    color: var(--sl-color-gray-2);
    font-size: 0.75rem;
    font-weight: 600;
    vertical-align: bottom;
    white-space: normal;
  }
  tr > :first-child {
    position: sticky;
    inset-inline-start: 0;
    z-index: 1;
    padding-inline-start: 0.625rem;
    border-inline-end: 1px solid var(--line);
  }
  tbody th {
    background-color: var(--sl-color-bg);
    font-weight: 600;
  }
  /* Sign-in: the one column of prose. */
  tbody td:nth-of-type(1) {
    min-width: 8.25rem;
    white-space: normal;
  }
  /* A box just too narrow for the table, as on a laptop with the table of contents beside it: tighter, so it fits
   * rather than hide the last column. Narrower ones scroll anyway, so they keep the roomier cells. */
  @container (min-width: 656px) and (max-width: 712px) {
    th,
    td {
      padding-inline: 0.3125rem;
    }
    tbody td:nth-of-type(1) {
      min-width: 6.25rem;
    }
  }
  tbody tr:not(.current):hover > * {
    background-image: linear-gradient(var(--row-hover), var(--row-hover));
  }

  .provider {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--sl-color-white);
    white-space: normal;
  }
  a.provider {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }
  a.provider:hover span {
    text-decoration: underline;
  }
  .provider img {
    flex: none;
    width: 20px;
    height: 20px;
  }

  /* This page's own row: tinted, marked, and not a link. */
  tr.current > * {
    background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
  }
  tr.current > th {
    box-shadow: inset 3px 0 0 var(--sl-color-accent);
  }
  .here {
    display: block;
    color: var(--sl-color-accent-high);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* The helper's need, from strongest to weakest, as the app's provider dialog shows it. */
  .need {
    display: inline-block;
    padding: 0.0625rem 0.3125rem;
    /* Translucent, so it shows on the current row's tint too. */
    border: 1px solid color-mix(in srgb, var(--sl-color-gray-3) 45%, transparent);
    border-radius: 999px;
    color: var(--sl-color-gray-3);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }
  /* The deeper green keeps its contrast on the tint, the current row's included. */
  .need.recommended {
    border-color: color-mix(in srgb, var(--sl-color-accent) 40%, transparent);
    background: var(--accent-soft);
    color: var(--sl-color-accent-high);
  }
  .need.required {
    border-color: var(--button);
    background: var(--button);
    color: var(--button-text);
    font-weight: 700;
  }
  :global(:root[data-theme="dark"]) .need {
    border-radius: 0;
  }

  .yes {
    display: inline-block;
    vertical-align: middle;
    color: var(--sl-color-text-accent);
  }
  .no {
    color: var(--sl-color-gray-3);
  }

  sup {
    margin-inline-start: 0.125rem;
    font-size: 0.6875rem;
    line-height: 0;
  }
  sup a {
    position: relative;
    color: var(--sl-color-text-accent);
    font-weight: 700;
    text-decoration: none;
  }
  /* A larger target than the digit. */
  sup a::after {
    content: "";
    position: absolute;
    inset: -0.5rem -0.375rem;
  }
  sup a:hover {
    text-decoration: underline;
  }
  a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .notes {
    margin-top: 0.75rem;
    padding-inline-start: 1.25rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .notes li + li {
    margin-top: 0.25rem;
  }
  .notes li:target {
    color: var(--sl-color-white);
    background: var(--accent-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .notes li {
      transition: background-color 0.3s ease;
    }
  }
</style>
