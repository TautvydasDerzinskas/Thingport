# Local secrets and environment overrides
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Node and Vite
node_modules/
dist/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Bridge builds: a plain `go build` in bridge/ writes the binary there. Releases come from bridge-release.yml
# (into bridge/dist/, ignored above).
bridge/thingport-bridge
bridge/thingport-bridge.exe

# Prisma
backend/prisma/dev.db*

# Thingport runtime content
data/
# …but a tool's own part data is source, not a runtime folder.
!tools/*/source/data/
imports/
backend/storage/

# IDE, operating-system, and temporary files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*.tmp
*.temp
*.log

# Regression pack (Playwright) output
regression/.auth/
regression/test-results/
regression/playwright-report/
regression/consume/
regression/fake-provider-gates/

# A local page for running a tool against the real SDK while working on it; never part of a build.
frontend/tool-harness.html
frontend/src/toolHarness.ts
frontend/public/tool-harness/
