# Copy this file to ".env" next to docker-compose.yml in your Thingport dataset
# (or paste its contents into the Custom App's Environment Variables editor),
# then fill in the required values.

# Required
# a dataset path on one of your pools -- replace "tank" with your actual pool name
APPDATA_PATH=/mnt/tank/apps/thingport
# AUTH_SECRET signs login tokens -- use your own random value, e.g. `openssl rand -hex 32`
AUTH_SECRET=changeme-generate-a-random-64-char-hex-string
# the first account to register with this email becomes admin
INITIAL_ADMIN_EMAIL=you@example.com
POSTGRES_PASSWORD=change-this-password

# Optional (defaults shown)
# match these to the owner of APPDATA_PATH if you see permission errors
PUID=1000
PGID=1000
WEB_PORT=80
POSTGRES_USER=thingport
POSTGRES_DB=thingport
# e.g. https://thingport.example.com -- needed for links in verification emails
PUBLIC_URL=
# login token lifetime, in seconds
AUTH_TOKEN_TTL=43200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thingport <no-reply@localhost>
FLARESOLVERR_URL=http://flaresolverr:8191/v1
TZ=UTC
