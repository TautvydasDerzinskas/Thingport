generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum CategorySource {
  MANUAL
  RULE
  AI
  LEGACY
}

/// What an AI connection sends as reasoning_effort, spelled the way providers expect it.
enum ReasoningEffort {
  none
  low
  medium
  high
}

/// How Thingport talks to an AI: the OpenAI-style chat API most providers and local servers offer, or Anthropic's own
/// Messages API for Claude.
enum AiProviderKind {
  openai
  anthropic
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  // Null for someone who has only ever signed in through an OIDC provider.
  passwordHash             String?
  displayName              String
  /// What people on connected instances call them, as username@this-instance: lower case, unique, editable.
  /// Made from the display name; null only until something reads it (ensureUsername).
  username                 String?                  @unique
  role                     Role                     @default(MEMBER)
  // The first admin: may demote and delete other admins, and can be neither demoted nor deleted.
  isOwner                  Boolean                  @default(false)
  // Defaults true so existing accounts aren't locked out; registration sets false when SMTP is on.
  emailVerified            Boolean                  @default(true)
  emailVerificationToken   String?                  @unique
  emailVerificationExpires DateTime?
  // Awaiting confirmation of an email change.
  pendingEmail             String?
  // SHA-256 of the emailed token, so a database leak can't be used to take over accounts.
  passwordResetTokenHash   String?                  @unique
  passwordResetExpires     DateTime?
  // A read-only token other apps use to call the API as this user. Only its SHA-256
  // is stored; the token itself is shown once, when generated. One per user: generating replaces it.
  apiTokenHash             String?                  @unique
  // The token's last four characters, so the profile can show which one is in use.
  apiTokenHint             String?
  apiTokenCreatedAt        DateTime?
  apiTokenLastUsedAt       DateTime?
  // The MCP tools the token may call at /api/mcp (see mcp/tools.ts). Chosen per token, so a tool
  // that writes is only ever reachable if the user ticked it.
  apiTokenMcpTools         String[]                 @default([])
  // What the token may read over the REST API, by scope (see services/apiTokenScopes.ts).
  apiTokenRestScopes       String[]                 @default([])
  // The slicer a model's "Open in" button opens: the last one used. Always one of `slicers`.
  slicer                   String?
  // The slicers the user has installed, offered in a model's "Open in" menu.
  slicers                  String[]                 @default([])
  // The slicers with a link handler of their own that open through Thingport Bridge instead, for when one can't
  // download from this instance. Kept while a slicer is switched off.
  bridgedSlicers           String[]                 @default([])
  // The printer each slicer's adapted copies are made for (src/adapter/printer.ts), as { [slicer id]: catalogue id }
  // of one of `printers`. A slicer not listed asks which when a model is opened adapted in it.
  slicerPrinters           Json?
  // The slicers that open a model's file as it is, with "Open adapted" switched off for them.
  unadaptedSlicers         String[]                 @default([])
  // Printers suggested to them that they turned down, by catalogue id: still shown, as declined.
  declinedPrinters         String[]                 @default([])
  // "light" | "dark" | "system"; null means never set.
  themePreference          String?
  // One of ACCENT_COLORS; null means Thingport green.
  accentColor              String?
  // What generated renders are tinted, one of RENDER_COLORS; null follows the accent.
  renderColor              String?
  // Which tree the models page shows: "categories" | "folders"; null means categories.
  categoriesView           String?
  // How the Tools page is arranged: { layout, sort, categories: { [toolId]: category } }. Null until it's changed.
  toolsView                Json?
  // The dashboard widgets the user had switched on or off, as { [widgetId]: boolean }. Superseded by
  // dashboardTemplates; read only to carry the user's choices into their first template.
  dashboardWidgets         Json?
  // How the dashboard arranged its boxes, one of DASHBOARD_LAYOUTS; null when never chosen. Superseded like the above.
  dashboardLayout          String?
  // The dashboard's templates and which one shows: { active, templates: [{ id, name, preset, panels, layouts }] }.
  // Null until the user's first visit after it arrived, when the frontend builds it from the two above.
  dashboardTemplates       Json?
  // What model cards lead with, one of CARD_PREVIEWS; null means "images".
  cardPreview              String?
  // How a model page shows the print profiles a model was imported with, one of PRINT_PROFILES_VIEWS ("off" shows
  // them as plain files); null means "picker".
  printProfilesView        String?
  // Where Studio's assistant shows its conversation, one of STUDIO_PROMPT_LAYOUTS; null means "bar".
  studioPromptLayout       String?
  // The units a new Studio design starts in, one of STUDIO_UNITS; null means "mm".
  studioUnits              String?
  // How Studio's grid is drawn and snapped to (StudioGrid); null, or anything left out, is its default.
  studioGrid               Json?
  // Where the dashboard's weather is for: { lat, lon, name, source }. Null until the user sets one.
  weatherLocation          Json?
  authorPreviewEnabled     Boolean                  @default(true)
  // Model cards cycle through a model's pictures while hovered.
  hoverSlideshowEnabled    Boolean                  @default(true)
  // Links sent from Thingport Grab's "Add to the queue" join the line by themselves instead of waiting on hold.
  startGrabLinks           Boolean                  @default(false)
  // Set on My models, or filled from the first linked Author with this data while still empty.
  bio                      String?
  // The cover picture: one uploaded (/api/covers/...) or a linked Author's. Null shows a drawn cover, coverPreset.
  backgroundUrl            String?
  // One of COVER_PRESETS (profileCoverService.ts); null is the one their id picks.
  coverPreset              String?
  // Where the cover is cropped, 0 (its top) to 100 (its bottom); null is the middle.
  coverPositionY           Int?
  // Up to five web addresses of theirs, shown under the bio.
  profileLinks             String[]                 @default([])
  // Their own models, as My models lists them, shown to the other users on Explore while social features are on.
  modelsPublic             Boolean                  @default(false)
  // When they last made them public: on Explore, sharing them counts as recent then, however old the models are.
  modelsPublicAt           DateTime?
  // Their avatar: a picture (one uploaded, /api/avatars/..., or a linked Author's). Null shows avatarStyle's design.
  avatarUrl                String?
  // The Thingport avatar they designed (avatarArt.ts's AvatarStyle), kept while a picture is shown. Null with no
  // picture either: their Gravatar, else a design picked from their id.
  avatarStyle              Json?
  // When they last had Thingport in front of them, as Chats' unread poll says: what shows them online to the others.
  lastSeenAt               DateTime?
  categories               Category[]
  prints                   Print[]
  collections              Collection[]
  customWidgets            CustomWidget[]
  tools                    Tool[]
  toolData                 ToolData[]
  icons                    UserIcon[]
  printers                 UserPrinter[]
  studioDesigns            StudioDesign[]
  collectionSyncs          CollectionSync[]
  providerListings         ProviderListing[]
  importJobs               ImportJob[]
  grabImports              GrabImport[]
  notifications            Notification[]
  systemReceipts           SystemReceipt[]
  logs                     Log[]
  authorLinks              AuthorLink[]
  bookmarks                Bookmark[]
  activities               Activity[]
  invitationsSent          Invitation[]
  identities               UserIdentity[]
  grabConnections          GrabConnection[]
  providerConnections      ProviderConnection[]
  sessions                 Session[]
  chatMemberships          ChatMember[]
  collectionShares         CollectionShare[]
  remoteCollectionViews    RemoteCollectionViewer[]
  chatMessages             ChatMessage[]
  chatsCreated             Chat[]                   @relation("ChatCreatedBy")
  peerRequests             PeerRequest[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
}

// Lets one email register while registrations are closed. Re-inviting replaces the token.
model Invitation {
  id          String   @id @default(cuid())
  email       String   @unique
  token       String   @unique
  invitedById String?
  invitedBy   User?    @relation(fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Category {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  tags            String[]         @default([])
  // "category" (the starter categories imports sort into) or "folder" (the user's own tree, e.g.
  // from uploading folders). Always the same as the top-level ancestor's.
  kind            String           @default("folder")
  parentId        String?
  parent          Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[]       @relation("CategoryTree")
  // Order among siblings. No unique index: Postgres treats NULL parentIds as distinct.
  position        Int              @default(0)
  metaTitle       String?
  metaDescription String?
  // The ids on each provider's site imports land in this category by (CategorySiteId).
  siteIds         CategorySiteId[]
  prints          Print[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, parentId, position])
  @@index([tags], type: Gin)
}

model Print {
  id                       String                   @id @default(cuid())
  userId                   String
  user                     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                     String
  nameNormalized           String
  title                    String?
  notes                    String?
  creator                  String?
  tags                     String[]                 @default([])
  viewCount                Int                      @default(0)
  printCount               Int                      @default(0)
  // Back the Favourites and Browsing History pseudo-collections.
  favoritedAt              DateTime?
  lastViewedAt             DateTime?
  // Dedupes re-imports of the same design. Null for uploads and unidentifiable sources.
  sourceProvider           String?
  sourceExternalId         String?
  // Gaps (see services/sourceGaps.ts) the source had nothing for at the last fill.
  unfillableGaps           String[]                 @default([])
  // The source published the script this model is generated from, but its creator chose not to share it. Worth
  // keeping, because from the outside a withheld script and a model that never had one look identical: no script
  // beside it and no way to customize it. The site says so only at import, and answers the request for a withheld
  // one with an empty download rather than a refusal.
  generatorScriptWithheld  Boolean                  @default(false)
  // The model's licence (services/licenseService.ts): what its source lists, or what its owner picked. Null when nothing
  // says.
  license                  Json?
  // What that licence allows, of LICENSE_ACTIONS (services/licenseCatalog.ts), for the "Licence allows" filter.
  licenseAllows            String[]                 @default([])
  // When the source was last read for it, or the owner picked one. Null on an import from before licences were
  // kept, read when its owner next opens it.
  licenseReadAt            DateTime?
  categoryId               String?
  category                 Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categorySource           CategorySource?
  // A provider result awaiting the owner's review: { categoryId, confidence, reason, model, createdAt }.
  aiSuggestion             Json?
  // A rejected category is never offered to the provider for this model again.
  aiRejectedCategoryIds    String[]                 @default([])
  // Improved descriptions: a suggested rewrite awaiting review, { notes, model, createdAt }.
  aiDescriptionSuggestion  Json?
  // The description before an AI rewrite was applied, so it can be reverted; null once edited by hand.
  aiDescriptionOriginal    String?
  aiDescriptionAppliedAt   DateTime?
  // Of the description and the options the AI last looked at, so a run skips models with nothing new.
  aiDescriptionCheckedHash String?
  authorId                 String?
  author                   Author?                  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  sourcePath               String?
  // The folder beside its files that holds the model's pictures (see services/modelAssets.ts), relative to
  // storage. Null for a model from before, whose pictures are still in the shared folders keyed by id.
  assetsPath               String?                  @unique
  plates                   Plate[]
  previewImages            PreviewImage[]
  descriptionImages        DescriptionImage[]
  files                    PrintFile[]              @relation("PrintFiles")
  preparedFileId           String?                  @unique
  preparedFile             PrintFile?               @relation("PreparedFile", fields: [preparedFileId], references: [id], onDelete: SetNull)
  preparedMetadata         Json?
  collectionItems          CollectionItem[]
  // Set on a model a tool brought with it (services/toolsService.ts): it can't be edited or deleted, and goes when
  // an admin uninstalls the tool.
  toolId                   String?
  tool                     Tool?                    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  // Which of the tool's models it is, from the tool's metadata.
  toolKey                  String?
  // The model this one was copied from, out of another user's public collection (services/modelCopyService.ts). The
  // copy is the user's own: the original changing, going private or being deleted leaves it as it is.
  copiedFromId             String?
  /// A copy of a partner instance's model: `{ apId, origin, instance, ownerName, ownerHandle }`, kept so the copy says
  /// where it came from and the original's page offers it again (federation/remoteCopy.ts).
  remoteSource             Json?
  copiedFrom               Print?                   @relation("PrintCopies", fields: [copiedFromId], references: [id], onDelete: SetNull)
  copies                   Print[]                  @relation("PrintCopies")
  // The first original of that chain: what a copy of a copy is a copy of. No relation, so it outlasts the original's
  // deletion, and with it the knowledge that the user already has the model. One copy per user and original.
  originalId               String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  // Generated column (name A, tags B, notes C, creator D) created with its GIN index in a
  // hand-written migration, since Prisma can't express a generated tsvector.
  searchVector             Unsupported("tsvector")?
  // Sent in chats: whoever can read one of those chats can open it (socialService's readablePrintWhere).
  chatAttachments          ChatAttachment[]

  @@unique([userId, categoryId, nameNormalized])
  @@unique([userId, sourceProvider, sourceExternalId])
  @@unique([userId, toolId, toolKey])
  @@unique([userId, originalId])
  @@index([userId, categoryId, name])
  @@index([tags], type: Gin)
  @@index([authorId])
  @@index([userId, favoritedAt])
  @@index([userId, lastViewedAt])
  @@index([toolId])
  @@index([copiedFromId])
}

/// A user-curated group of models. Collection imports reuse a row by nameNormalized.
model Collection {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  nameNormalized String
  description    String?
  tags           String[]                 @default([])
  items          CollectionItem[]
  bookmarks      Bookmark[]
  // The provider collections it follows, oldest first. Each is checked and set up on its own.
  syncs          CollectionSync[]
  // Set on the collection a tool keeps its models in: fixed, listed last, and gone with the tool.
  toolId         String?
  tool           Tool?                    @relation(fields: [toolId], references: [id], onDelete: Cascade)
  // Who besides its owner sees it, while an admin has social features on (services/socialService.ts): nobody, the
  // people in `shares`, or everyone (on Explore). Those who see it can open, download and copy its models.
  visibility     CollectionVisibility     @default(PRIVATE)
  // Who it's shared with. Kept while it's private or public too, so sharing it again needs no picking.
  shares         CollectionShare[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  // Generated column (name A, tags B, description C); see Print.searchVector.
  searchVector   Unsupported("tsvector")?

  @@unique([userId, nameNormalized])
  @@index([tags], type: Gin)
  @@index([toolId])
  @@index([visibility])
}

enum CollectionVisibility {
  PRIVATE
  SHARED
  PUBLIC
}

/// One person a collection is shared with: someone here (`userId`) or on a partner instance (`remotePersonId`),
/// never both. They see it while it's SHARED, as they would a public one.
model CollectionShare {
  id             String        @id @default(cuid())
  collectionId   String
  collection     Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  remotePersonId String?
  remotePerson   RemotePerson? @relation(fields: [remotePersonId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([collectionId, userId])
  @@unique([collectionId, remotePersonId])
  @@index([userId])
  @@index([remotePersonId])
}

/// Keeps a collection in step with one on a provider: models added there later are imported into
/// it by the scheduled sync (services/collectionSyncRunner.ts). Made by Thingport Grab or the sync dialog's Browse
/// tab. A collection can follow several, from one provider or many; a provider collection feeds only one.
/// Tracked by the provider's own id, so renaming either side keeps the link.
model CollectionSync {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectionId  String
  collection    Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  provider      String
  externalId    String
  sourceUrl     String
  // The provider collection's name when it was linked, to tell a collection's sources apart. Null on links made
  // before it was kept, and on Likes, which are named after their user.
  title         String?
  // MakerWorld only: which print profiles a new model brings ("url" is the model's default one).
  // New MakerWorld syncs start on "designer" (see createSync).
  profileScope  String      @default("url")
  // How often the provider's collection is checked: 1, 6 or 24.
  intervalHours Int         @default(24)
  // Every model id the provider's collection has listed, so a sync only imports what's new since.
  knownIds      String[]    @default([])
  // Checks in a row that found the provider's collection gone. One bad answer doesn't unsync it.
  missingChecks Int         @default(0)
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  importJobs    ImportJob[]

  @@unique([userId, provider, externalId])
  @@index([collectionId])
}

/// Lists Thingport Grab reads from a provider with the user's own login, for what the instance
/// can't read itself: Printables shows private collections and likes to their owner only. Pushed
/// on the user's visits to the site, so they're as fresh as the last one.
model ProviderListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String
  /// "collections": the user's collections, as the Browse tab shows them. "likes": their liked
  /// models. Anything else: a collection's id, for its model ids.
  key       String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([userId, provider, key])
}

/// An import waiting for Thingport Grab, because its files only a page of the site's own can get: MakerOnline signs
/// its download links solely for a page its anti-bot script runs on, and an OwlCAD CAD project has no stored mesh at
/// all -- its editor builds the file. An import started in the app, the queue or a sync waits here until Grab, on the
/// next page it sees of that site, fetches the files and imports it.
model GrabImport {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Whose row it is: Grab asks for one provider's at a time, on that provider's own pages.
  provider     String   @default("makeronline")
  /// The model's page, with `#profileId-<id>` when it names a print profile.
  url          String
  /// "url" | "designer" | "all", as for MakerWorld.
  scope        String   @default("url")
  collectionId String?
  categoryId   String?
  tags         String[] @default([])
  notes        String?
  attempts     Int      @default(0)
  lastError    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId, provider])
}

enum BookmarkType {
  TAG
  COLLECTION
}

/// A tag or collection pinned to the sidebar. Both kinds share one `order` sequence.
///
/// Exactly one of `tag` / `collectionId` is set, matching `type`. Postgres treats NULLs as
/// distinct, so each @@unique only dedupes its own type's rows.
model Bookmark {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         BookmarkType
  tag          String?
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  order        Int
  createdAt    DateTime     @default(now())

  @@unique([userId, type, tag])
  @@unique([userId, collectionId])
  @@index([userId, order])
}

model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  printId      String
  print        Print      @relation(fields: [printId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([collectionId, printId])
  @@index([collectionId, position])
  @@index([printId])
}

enum ImportJobType {
  COLLECTION
  ZIP
  PROFILES
  LINKS
}

enum ImportJobStatus {
  RUNNING
  DONE
  ERROR
  // A job waiting for someone to start it: the extension's "Add to the queue" collects links here,
  // pausing a running LINKS job parks its remaining links here too, and any job in line can be held here.
  PAUSED
  // In line for the one import worker (services/importWorker.ts), in queuedAt order. A sync's job never is:
  // it runs in the sync lane. Old clients read this as RUNNING (dto.ts).
  QUEUED
}

/// A background batch import. The worker runs one line job at a time for the whole server, the sync lane
/// its own beside it; a job started without the line still refuses a second RUNNING one of the user
/// (routes/imports.ts).
model ImportJob {
  id                 String          @id @default(cuid())
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               ImportJobType
  status             ImportJobStatus @default(RUNNING)
  sourceUrl          String
  sourceLabel        String?
  provider           String?
  total              Int             @default(0)
  processed          Int             @default(0)
  imported           Int             @default(0)
  alreadyInLibrary   Int             @default(0)
  failedCount        Int             @default(0)
  errorMessage       String?
  resultCollectionId String?
  // Set when the job created exactly one Print, so the frontend can open it directly.
  resultPrintId      String?
  // The request a job runs from (never the MakerWorld cookie, a captcha or anything resolved in the
  // browser), so the worker or a retry can run it later, and what its run has to say about itself.
  payload            Json?
  // Set on the LINKS jobs a collection sync queues. They pause on a rate limit instead of failing
  // the rest, and are kept out of the extension's "Add to the queue" job.
  collectionSyncId   String?
  collectionSync     CollectionSync? @relation(fields: [collectionSyncId], references: [id], onDelete: SetNull)
  // When it joined the line, which orders it (Start and Retry go to the back). Null on anything that never did.
  queuedAt           DateTime?
  // When this run began. Null until then.
  startedAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  items              ImportJobItem[]

  @@index([userId, status])
  @@index([collectionSyncId])
  @@index([status, queuedAt])
}

enum ImportJobItemStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// One queued URL of a LINKS job, kept so failed links can be retried after a LINKS run.
model ImportJobItem {
  id           String              @id @default(cuid())
  jobId        String
  job          ImportJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  url          String
  status       ImportJobItemStatus @default(PENDING)
  attempts     Int                 @default(0)
  errorMessage String?
  // Per-link options a queued link carries on its own (collection_id, scope, title), over the
  // job's shared payload.
  payload      Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([jobId, status])
}

model Notification {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What it's about, for its icon: import, sync, queue, consume, ai, system, chat or general.
  type         String    @default("general")
  /// Set on notifications later ones may fold into, e.g. { key: "single-import", items: [...] }.
  group        Json?
  title        String
  /// The title as the app translates it, { key, values }: `title` stays the English, for anything else that reads it.
  /// Null on a kind not translated yet, and on those written before.
  message      Json?
  body         String?
  externalUrl  String?
  internalPath String?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  // For the daily cleanup of old notifications.
  @@index([createdAt])
}

/// Which system notifications (from the repo's system-notifications.json) a user was already sent,
/// so deleting or pruning the notification never brings it back.
model SystemReceipt {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemId  String
  createdAt DateTime @default(now())

  @@id([userId, systemId])
  @@index([createdAt])
}

/// A creator on a source platform. `id` is provider-prefixed ("makerworld:3582000380") so
/// re-imports upsert the same row.
model Author {
  id            String      @id
  provider      String
  externalId    String
  name          String?
  handle        String?
  bio           String?
  bioTranslated String?
  links         String[]    @default([])
  avatarUrl     String?
  backgroundUrl String?
  prints        Print[]
  link          AuthorLink?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([provider, externalId])
}

/// Claims an Author as "this is me". An Author maps to at most one user, and a user has at most
/// one linked identity per provider.
model AuthorLink {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId  String   @unique
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  // Denormalized so the [userId, provider] unique index needs no join.
  provider  String
  createdAt DateTime @default(now())

  @@unique([userId, provider])
}

model Plate {
  id               String   @id @default(cuid())
  printId          String
  print            Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  position         Int
  filename         String
  mime             String
  size             Int      @default(0)
  storagePath      String   @unique
  sourcePath       String?
  // The folder its source kept it in ("USB C version/Handles"), levels joined by "/"; null for none. Names are unique
  // within a folder, not the whole model (utils/fileFolder.ts).
  folder           String?
  // The print profile ("instance" on MakerWorld) this file came from. Each profile's 3MF has its own print
  // settings, so each gets its own Plate.
  sourceInstanceId String?
  // What the model page shows of that profile -- its name, time, filament, plates, printer and settings -- read from
  // its provider and its 3MF (services/printProfileService.ts StoredProfile). Null until first read.
  profile          Json?
  // SHA-256 of the file, recorded when it's stored (with file reuse on) or when first needed. The file may be edited
  // outside Thingport, so this is checked against the file before it's relied on.
  contentSha256    String?
  // What the file was when the file reuse backfill last made it share its bytes with an identical one (its inode and
  // ctime, in nanoseconds): a file that still matches is left alone on the next run. Any change to the file, or a new
  // file at its path, makes it differ.
  reuseIno         BigInt?
  reuseCtimeNs     BigInt?
  // The thumb is our own 3D render, which an imported image replaces.
  thumbGenerated   Boolean  @default(false)
  // The printability check's result (services/meshQuality.ts QualityReport), or { version, status: "skipped" }
  // for a file it couldn't check. Null until the model is first opened with checks on.
  qualityCheck     Json?
  // What kind of 3MF it is (src/adapter/format.ts ThreeMfFormat): which slicer wrote it, its designer's printer, its
  // plates. Read when it's stored; null for other files and until an older 3MF's model is opened.
  format           Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([printId, position])
  @@unique([printId, sourceInstanceId])
  @@index([printId])
  // Finds a stored copy of a new plate's file to share (services/printCreation.ts).
  @@index([contentSha256])
}

/// A photo of the finished model, stored as a normalized JPEG keyed by id. Position 0 is the
/// main image.
model PreviewImage {
  id            String   @id @default(cuid())
  printId       String
  print         Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  position      Int
  // Our own 3D render, which an imported image replaces.
  generated     Boolean  @default(false)
  // Size and SHA-256 of the stored (re-encoded) JPEG, recorded when it's stored with file reuse on or when first needed.
  // The file may be edited outside Thingport, so these are checked against it before they're relied on.
  size          Int?
  contentSha256 String?
  // See Plate.reuseIno.
  reuseIno      BigInt?
  reuseCtimeNs  BigInt?
  createdAt     DateTime @default(now())

  @@unique([printId, position])
  @@index([printId])
  // Finds a stored copy of a new file to share (services/storedContent.ts).
  @@index([contentSha256])
}

enum PrintFileRole {
  SUPPORTING
  PREPARED
  // The LICENSE.txt Thingport writes beside a model's files (services/licenseFile.ts).
  LICENSE
}

// Images embedded in a print's Markdown notes, stored locally so the description survives the
// source changing or going away. Referenced from the notes as /description-image/<id>.
model DescriptionImage {
  id            String   @id @default(cuid())
  printId       String
  print         Print    @relation(fields: [printId], references: [id], onDelete: Cascade)
  // Where an imported image came from, so a refresh reuses it instead of downloading again.
  sourceUrl     String?
  mime          String
  size          Int
  // See Plate.contentSha256.
  contentSha256 String?
  // See Plate.reuseIno.
  reuseIno      BigInt?
  reuseCtimeNs  BigInt?
  createdAt     DateTime @default(now())

  @@index([printId])
  // Finds a stored copy of a new file to share (services/storedContent.ts).
  @@index([contentSha256])
}

model PrintFile {
  id            String        @id @default(cuid())
  printId       String
  print         Print         @relation("PrintFiles", fields: [printId], references: [id], onDelete: Cascade)
  role          PrintFileRole
  filename      String
  // As Plate.folder.
  folder        String?
  mime          String
  size          Int           @default(0)
  storagePath   String        @unique
  metadata      Json?
  // See Plate.contentSha256.
  contentSha256 String?
  // See Plate.reuseIno.
  reuseIno      BigInt?
  reuseCtimeNs  BigInt?
  createdAt     DateTime      @default(now())
  preparedFor   Print?        @relation("PreparedFile")

  @@index([printId, role])
  // Finds a stored copy of a new file to share (services/storedContent.ts).
  @@index([contentSha256])
}

/// A dashboard widget the user made, or installed from the community repository. Its script runs in the user's own
/// dashboard page; a community one runs as installed, until the user takes an update.
model CustomWidget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "own" or "community".
  source    String
  /// The folder name: unique among a user's own widgets, and the community repository's for an installed one.
  slug      String
  /// The validated metadata: name, description, icon, size, settings, hosts, labels and screenshots.
  manifest  Json
  script    String
  html      String?
  /// Its labels by language, as { "en": { "key": "text" } }: what `thingport.t()` reads.
  locales   Json?
  /// Of the installed files, to tell when the community repository's copy has changed.
  sha       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source, slug])
  @@index([userId])
}

/// An image the user uploaded to pick as an icon, for a launcher link or a custom widget.
/// A tool: a small app that opens in a window from the Tools page. An admin installs one from the repository's tools
/// folder for the whole instance, or a user makes their own (services/toolsService.ts).
model Tool {
  id           String       @id @default(cuid())
  /// "repo" for one installed from the repository, "own" for one a user made.
  source       String
  /// "repo" for a repository tool, its owner's id for an own one: the unique index covers both, where a null owner
  /// wouldn't (Postgres treats nulls as distinct).
  scope        String
  slug         String
  /// The maker of an own tool; null for a repository one.
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The validated metadata: name, description, icon, window size, hosts and, for a repository tool, its models.
  manifest     Json
  script       String
  html         String?
  /// Its labels by language, as { "en": { "key": "text" } }: what `thingport.t()` reads.
  locales      Json?
  /// Of the installed files, to tell when the repository's copy has changed.
  sha          String
  /// Of the models it brings, so an update that leaves them alone doesn't make everyone's copies again.
  modelsSha    String?
  /// The models that couldn't be fetched at the last try, as { [key]: reason }.
  modelsFailed Json?
  data         ToolData[]
  collections  Collection[]
  prints       Print[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([scope, slug])
  @@index([userId])
}

/// A design made in Studio: a parametric feature tree, as frontend/src/studio/document.ts describes it.
model StudioDesign {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  document  Json
  /// Goes up with every change, undo and redo too, so an open page can tell the design changed under it.
  version   Int              @default(0)
  /// Which revision `document` is: undo moves it back one, redo forward.
  position  Int              @default(0)
  revisions StudioRevision[]
  messages  StudioMessage[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, updatedAt])
}

/// A design as one command left it, for undo and redo, and a record of who changed what.
model StudioRevision {
  id        String       @id @default(cuid())
  designId  String
  design    StudioDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  position  Int
  document  Json
  /// The command that made it, null for the design's start.
  command   String?
  args      Json?
  summary   String?
  /// "user" from the page, "mcp" from an assistant connected with an API token, "assistant" from Studio's own.
  actor     String
  createdAt DateTime     @default(now())

  @@unique([designId, position])
}

/// The conversation with Studio's assistant about one design: what was asked, what it answered and the steps it took,
/// so a later prompt can build on it. Text only: the AI's own working, tool payloads and thinking aren't kept.
model StudioMessage {
  id        String       @id @default(cuid())
  designId  String
  design    StudioDesign @relation(fields: [designId], references: [id], onDelete: Cascade)
  /// "user" or "assistant".
  role      String
  text      String
  /// An answer's steps, [{ tool, title, summary, ok }], and how its run ended: done, stopped, limit or failed.
  steps     Json?
  outcome   String?
  /// Why a failed run stopped, in the provider's words.
  error     String?
  /// The AI that answered, as it was named then.
  model     String?
  /// A prompt's pictures, [{ id, width, height }], kept beside the design as <id>.png.
  pictures  Json?
  createdAt DateTime     @default(now())

  @@index([designId, createdAt])
}

/// What a tool keeps for a user through `thingport.storage`: JSON values by key.
model ToolData {
  id        String   @id @default(cuid())
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  /// The value's size as JSON, so the quota is a sum rather than a scan of every value.
  size      Int
  updatedAt DateTime @updatedAt

  @@unique([toolId, userId, key])
  @@index([userId])
}

model UserIcon {
  /// Random, as it's also the public file name: /api/icons/<id>.<ext>.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The uploaded file's name, without its extension.
  name      String
  /// "png" or "svg".
  ext       String
  createdAt DateTime @default(now())

  @@index([userId])
}

// A printer someone prints on, from the printer catalogue (assets/printers): adapted copies can be made for it.
model UserPrinter {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The catalogue's id, "<brand>-<model>" ("bambulab-p1s").
  printerId String
  /// The nozzle fitted, in mm as slicers name it ("0.4").
  nozzle    String
  createdAt DateTime @default(now())

  @@unique([userId, printerId])
}

model Setting {
  key   String @id
  value Json
}

/// An AI service: OpenAI-compatible, or Claude. Features use the default one unless set to another.
model AiConnection {
  id              String           @id @default(cuid())
  kind            AiProviderKind   @default(openai)
  baseUrl         String
  /// Write-only: the API only ever says whether one is set.
  apiKey          String?
  model           String
  timeoutMs       Int              @default(60000)
  /// How many requests may wait on this provider at once.
  concurrency     Int              @default(1)
  /// Sent as reasoning_effort. Null sends nothing, leaving it to the provider.
  reasoningEffort ReasoningEffort?
  /// The model takes pictures in a prompt, which an admin says; features that send pictures only send them where it does.
  vision          Boolean          @default(false)
  isDefault       Boolean          @default(false)
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// An OpenID Connect identity provider (Authentik, PocketID, ...) people can sign in with.
model OidcProvider {
  id             String         @id @default(cuid())
  /// In the redirect URI, so it can't change once the IdP has been told about it.
  slug           String         @unique
  name           String
  issuerUrl      String
  clientId       String
  /// Write-only: the API only ever says whether one is set. Null for a public client.
  clientSecret   String?
  scopes         String         @default("openid email profile")
  enabled        Boolean        @default(true)
  /// Someone the provider vouches for but Thingport doesn't know gets a new account.
  createAccounts Boolean        @default(false)
  /// A first sign-in attaches to the account with the same (provider-verified) email.
  linkByEmail    Boolean        @default(false)
  position       Int            @default(0)
  identities     UserIdentity[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

/// Who a user is at an OIDC provider: its `sub`, which stays put when their email changes.
model UserIdentity {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerId String
  provider   OidcProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  subject    String
  /// The email the provider last gave, to show which of their accounts it is.
  email      String?
  lastUsedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([providerId, subject])
  @@index([userId])
}

/// A browser's Thingport Grab, connected by the user approving it in Thingport rather than by saving their
/// password in the extension. It trades its token for sessions, until the user removes it.
/// A user's sign-in on a provider, and who they are there (providers/connections.ts): one per user, provider and the
/// manifest's auth slot, so a provider needs no column of its own.
model ProviderConnection {
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  /// "default", or "browser" for a second sign-in beside it (Cults3D's).
  slot        String    @default("default")
  /// The credential, shaped as the provider's session.ts reads it; null once disconnected, the account kept.
  secret      Json?
  expiresAt   DateTime?
  /// When the provider last turned the secret down; a new one clears it.
  rejectedAt  DateTime?
  /// Who the user is there: the site's user id and name, where it has them.
  accountId   String?
  accountName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@id([userId, provider, slot])
}

/// One of a category's ids on a provider's site: an import whose site category is one lands in it. Each provider's ids
/// are its own; the starter categories' come from backend/src/providers/<id>/categories.json.
model CategorySiteId {
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  provider   String
  /// Text for every provider: numbers, NexPrint's 16-digit ones, or Thangs' "Parent/Child" paths.
  siteId     String
  /// The order they were given in.
  position   Int      @default(0)

  @@id([categoryId, provider, siteId])
  @@index([provider, siteId])
}

model GrabConnection {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the token; the token itself only ever reaches the extension.
  tokenHash  String    @unique
  /// Which browser it is, e.g. "Chrome on macOS", so the user can tell them apart.
  name       String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// A browser's sign-in. Its secret lives in an httpOnly cookie, so the browser can get a new access token after
/// that one runs out -- a dashboard left as a browser's homepage stays signed in. Signing out deletes it, and the
/// access tokens it issued (which name it) stop working with it.
model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the cookie's secret.
  tokenHash  String   @unique
  /// When the person actually signed in, carried into every token the session issues.
  signedInAt DateTime
  lastUsedAt DateTime @default(now())
  /// Moves forward each time it's used.
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Admin audit trail. Written fire-and-forget so logging never breaks the action.
model Log {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  targetId  String?
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// One per thing the user did to a model, for their activity heatmap: "import", "upload", "delete",
// "download" or "slicer". Separate from Log, which an import job writes once for many models and
// which can't tell a download from a slicer open.
model Activity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  // No relation: a deleted model keeps its history, shown by the name it had.
  printId   String?
  name      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum ChatKind {
  DIRECT
  ROOM
}

/// Chats (services/chatService.ts), while an admin has them on under social features: two users' direct messages, or
/// a room an admin made.
model Chat {
  id            String             @id @default(cuid())
  kind          ChatKind
  /// A room's. Direct messages are named after the other person.
  name          String?
  description   String?
  /// A room anyone may read and join. A private one's members are the users an admin picked.
  isPublic      Boolean            @default(false)
  /// Direct messages only: the two users' ids, sorted and joined, so a pair only ever has the one.
  directKey     String?            @unique
  createdById   String?
  createdBy     User?              @relation("ChatCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The latest message's time, for ordering the list; when it was made until there's one.
  lastMessageAt DateTime           @default(now())
  createdAt     DateTime           @default(now())
  members       ChatMember[]
  messages      ChatMessage[]
  /// People on partner instances in a chat hosted here: the other side of direct messages, or a room's members.
  remoteMembers ChatRemoteMember[]
  /// A room hosted on a partner instance (federation/chats.ts): its Group's id there, and the partner. Null for one
  /// hosted here.
  remoteApId    String?            @unique
  hostPeerId    String?
  hostPeer      Peer?              @relation(fields: [hostPeerId], references: [id], onDelete: Cascade)
  /// A room hosted elsewhere: all its members, wherever they are, as the host last said
  /// (`[{ id, name, handle, instance, origin }]`).
  hostMembers   Json?
  /// When the host last changed it, as its last update applied here said: an older one, retried late, is ignored.
  hostUpdatedAt DateTime?

  @@index([kind])
  @@index([hostPeerId])
}

/// Someone on a partner instance in a chat hosted here.
model ChatRemoteMember {
  chatId   String
  chat     Chat         @relation(fields: [chatId], references: [id], onDelete: Cascade)
  personId String
  person   RemotePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  joinedAt DateTime     @default(now())

  @@id([chatId, personId])
  @@index([personId])
}

model ChatMember {
  chatId     String
  chat       Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Pinned to the top of the list.
  favorite   Boolean   @default(false)
  /// Counted, but never notified, and left out of the sidebar's badge.
  muted      Boolean   @default(false)
  /// Messages after this are unread: what was said before someone joined isn't news to them.
  lastReadAt DateTime  @default(now())
  /// When the chat was last open in front of them, kept current while it is: a new message finding it so doesn't
  /// notify them.
  viewedAt   DateTime?
  joinedAt   DateTime  @default(now())

  @@id([chatId, userId])
  @@index([userId])
}

model ChatMessage {
  id               String           @id @default(cuid())
  chatId           String
  chat             Chat             @relation(fields: [chatId], references: [id], onDelete: Cascade)
  /// Null once the sender's account is gone: what they said stays, from a deleted user.
  senderId         String?
  sender           User?            @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// Emptied when it's deleted.
  body             String
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  attachments      ChatAttachment[]
  /// From someone on another instance: who, while they're known here, and as the message said
  /// (`{ id, name, handle, instance, origin }`), which stays when they aren't.
  remoteSenderId   String?
  remoteSender     RemotePerson?    @relation(fields: [remoteSenderId], references: [id], onDelete: SetNull)
  remoteSenderCard Json?
  /// Its id across instances: the sender's for one from elsewhere, ours once one written here is sent on.
  apId             String?          @unique

  @@index([chatId, createdAt])
  // For polls asking what was deleted since they last looked.
  @@index([chatId, deletedAt])
  @@index([senderId])
}

/// A model of the sender's own, sent in a chat message. Whoever can read the chat can open, download and copy it while
/// the message stays.
model ChatAttachment {
  id              String      @id @default(cuid())
  messageId       String
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  /// Null once the model's deleted: the message still says what was sent.
  printId         String?
  print           Print?      @relation(fields: [printId], references: [id], onDelete: SetNull)
  /// The model's name when it was sent.
  name            String
  position        Int         @default(0)
  /// A partner's model, sent from there, by its id there: opened from the index while it's in it.
  remoteModelApId String?

  @@index([messageId])
  @@index([printId])
}

// Connected instances (src/federation): other Thingport instances this one is paired with over ActivityPub.

enum PeerStatus {
  /// We asked; their admin hasn't answered yet.
  OUTGOING
  ACTIVE
  /// Ours to pause: nothing is sent to it, and what it sends is turned away to be retried later.
  PAUSED
  /// Whatever it sends is dropped without a word.
  BLOCKED
}

/// Another instance: asked by us, connected, paused or blocked. One asking us is a PeerRequest until an admin approves.
model Peer {
  id            String               @id @default(cuid())
  /// Scheme, host and port, as all of its addresses start: who it is here.
  origin        String               @unique
  name          String?
  version       String?
  /// Its instance actor and shared inbox, as it published them.
  actorUrl      String?
  inboxUrl      String?
  /// Its public keys as JWKs, kept from when an admin compared their fingerprint.
  publicKeys    Json?
  fingerprint   String?
  status        PeerStatus
  /// The Follow that paired us, ours or theirs: what an Undo or a Reject refers to.
  followId      String?
  /// "us" when we asked, "them" when they did.
  initiatedBy   String               @default("us")
  /// Ours, sent with our request.
  note          String?
  connectedAt   DateTime?
  /// When it last answered us, and when it last reached us: the second proves it can.
  lastSeenAt    DateTime?
  lastInboundAt DateTime?
  lastError     String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  deliveries    FederationDelivery[]
  /// When what it shares was last read into the index below, and why the last try failed.
  syncedAt      DateTime?
  syncError     String?
  /// One that can't reach the other keeps a link open to it instead: "ours" when this instance keeps it, "theirs"
  /// when the partner does. Everything for the side that can't be reached then goes through it (links.ts).
  link          String?
  /// The secret the link is opened with: as it is for "ours", its SHA-256 for "theirs".
  linkToken     String?              @unique
  /// When the link was last open.
  linkSeenAt    DateTime?
  /// "theirs": its actor document from when an admin compared its key, so its signatures are checked without asking it.
  actorDocument Json?
  people        RemotePerson[]
  models        RemoteModel[]
  collections   RemoteCollection[]
  withdrawn     RemoteGone[]
  rooms         Chat[]

  @@index([status])
}

/// A partner's person who shares something, as its directory last said: what Explore here shows of them. Read again
/// on every sync; gone with the partner.
model RemotePerson {
  id               String             @id @default(cuid())
  peerId           String
  peer             Peer               @relation(fields: [peerId], references: [id], onDelete: Cascade)
  /// Their Person actor's id, on the partner's origin.
  apId             String             @unique
  username         String?
  displayName      String
  bio              String?
  links            String[]
  /// Pictures, at the partner: fetched through this instance (federation/media.ts), never by a viewer's browser.
  avatarUrl        String?
  coverUrl         String?
  coverPreset      String?
  coverPositionY   Int                @default(50)
  modelCount       Int                @default(0)
  collectionCount  Int                @default(0)
  /// When they last shared something there: how Explore orders people.
  sharedAt         DateTime?
  joinedAt         DateTime?
  syncedAt         DateTime           @default(now())
  /// In its instance's directory: shown on Explore. Someone known only from a chat (they share nothing there, or no
  /// longer do) is kept unlisted while a chat still names them.
  listed           Boolean            @default(true)
  models           RemoteModel[]
  collections      RemoteCollection[]
  chats            ChatRemoteMember[]
  collectionShares CollectionShare[]
  messages         ChatMessage[]

  @@index([peerId])
  @@index([sharedAt])
}

/// A model a partner's person shares: read-only here until downloading and copying come.
model RemoteModel {
  id          String       @id @default(cuid())
  peerId      String
  peer        Peer         @relation(fields: [peerId], references: [id], onDelete: Cascade)
  personId    String
  person      RemotePerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  apId        String       @unique
  title       String
  /// Markdown, as its owner wrote it.
  description String?
  images      String[]
  /// `{ name, size, mediaType, url }` per file, with what a copy needs of each: `kind` ("plate" or "file"), `role`,
  /// `profileId`, `profile` and `thumb`.
  files       Json         @default("[]")
  /// What a copy needs to be the same model (federation/remoteCopy.ts): its tags, creator, source, category and the
  /// rest, as remoteIndex.ts read them. Null from a partner that doesn't say.
  details     Json?
  /// Known only from a collection its owner shared with people here (`RemoteCollection.limited`): off Explore, and
  /// opened only by those people. A model that's also shared openly there is read as not limited.
  limited     Boolean      @default(false)
  sharedAt    DateTime?
  updatedAt   DateTime?
  syncedAt    DateTime     @default(now())

  @@index([peerId])
  @@index([personId])
  @@index([sharedAt])
  /// Which models a picture is of, for the proxy that serves it (federation/media.ts).
  @@index([images], type: Gin)
}

/// A partner's person's public collection, and the models in it by their ids there.
model RemoteCollection {
  id          String                   @id @default(cuid())
  peerId      String
  peer        Peer                     @relation(fields: [peerId], references: [id], onDelete: Cascade)
  personId    String
  person      RemotePerson             @relation(fields: [personId], references: [id], onDelete: Cascade)
  apId        String                   @unique
  name        String
  description String?
  modelApIds  String[]
  updatedAt   DateTime?
  syncedAt    DateTime                 @default(now())
  /// Shared by its owner with some of this instance's people (`viewers`), sent to them rather than listed: off
  /// Explore, and opened only by them. Kept until its owner's instance says it's gone, or no longer answers for it.
  limited     Boolean                  @default(false)
  viewers     RemoteCollectionViewer[]
  /// When what's kept of it was asked of its partner, by its index or by a read of it as shared: the later of two
  /// reads is what's kept, whichever finishes last.
  fetchedAt   DateTime?

  @@index([peerId])
  @@index([personId])
  @@index([updatedAt])
}

/// A collection or model kept for people here that's gone, and as of when (what told this instance so was asked for,
/// or the model's last read as shared): a read of the partner's index asked for before then can't bring it back as
/// public. Kept until a read of the index begun after it is stored.
model RemoteGone {
  apId   String   @id
  peerId String
  peer   Peer     @relation(fields: [peerId], references: [id], onDelete: Cascade)
  at     DateTime

  @@index([peerId])
}

/// One of this instance's people a partner's person shared a collection with.
model RemoteCollectionViewer {
  collectionId String
  collection   RemoteCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When it was shared with them: how Shared with you orders it.
  createdAt    DateTime         @default(now())

  @@id([collectionId, userId])
  @@index([userId])
}

enum PeerRequestKind {
  /// Another instance asking to connect.
  INCOMING
  /// One of our users asking to reach someone on an instance we aren't connected with.
  LOCAL
}

enum PeerRequestStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
}

/// A request waiting for an admin here.
model PeerRequest {
  id              String            @id @default(cuid())
  kind            PeerRequestKind
  status          PeerRequestStatus @default(PENDING)
  origin          String
  /// Who on the asking side asked, and whom they want to reach, as the request named them.
  requesterName   String?
  requesterHandle String?
  requesterUrl    String?
  targetHandle    String?
  note            String?
  /// INCOMING: the signed Follow exactly as it came, checked only once an admin approves, so a stranger can't make
  /// this instance fetch anything.
  activity        Json?
  headers         Json?
  url             String?
  /// INCOMING, from an instance that can't be reached from here: the SHA-256 of the secret its link is opened with.
  linkToken       String?           @unique
  /// LOCAL: our user who asked.
  userId          String?
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([status, kind])
  @@index([origin])
  @@index([userId])
}

/// An activity on its way to another instance. Our own queue: Fedify's refuses addresses on a local network.
model FederationDelivery {
  id            String   @id @default(cuid())
  peerId        String?
  peer          Peer?    @relation(fields: [peerId], references: [id], onDelete: SetNull)
  /// The one origin it may go to, which also lets a goodbye reach an instance no longer connected.
  origin        String
  inboxUrl      String
  /// Who signs it: "instance", or a user's id.
  actor         String
  activity      Json
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  /// What it's one of (a chat: its room, or the person it's with): one waits for those before it, so a partner reads
  /// them in the order they happened.
  orderKey      String?
  createdAt     DateTime @default(now())

  @@index([nextAttemptAt])
  @@index([peerId])
  @@index([peerId, orderKey, createdAt])
}

/// Fedify's key-value store: public keys it fetched and activities it handled, each with an expiry.
model FederationKv {
  key       String    @id
  value     Json
  expiresAt DateTime?

  @@index([expiresAt])
}
