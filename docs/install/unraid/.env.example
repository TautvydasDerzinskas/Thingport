# Copy this file to ".env" next to docker-compose.yml in your Thingport stack folder
# (Compose Manager: Stack -> Edit -> Environment Variables), then fill in the required values.

# Required
# AUTH_SECRET signs login tokens -- use your own random value, e.g. `openssl rand -hex 32`
AUTH_SECRET=changeme-generate-a-random-64-char-hex-string
POSTGRES_PASSWORD=change-this-password

# Optional (defaults shown)
# Unraid's conventional "nobody:users" ids -- change if your appdata share uses different ownership
PUID=99
PGID=100
WEB_PORT=80
POSTGRES_USER=thingport
POSTGRES_DB=thingport
# e.g. https://thingport.example.com -- needed for links in verification emails
PUBLIC_URL=
# login token lifetime, in seconds
AUTH_TOKEN_TTL=43200
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Thingport <no-reply@localhost>
FLARESOLVERR_URL=http://flaresolverr:8191/v1
TZ=UTC
