{
  "name": "Countdown",
  "description": "Days, hours and minutes left until a date you pick, such as a print deadline or a convention.",
  "iconUrl": "builtin:thingport/hourglass",
  "version": "1.0.0",
  "author": "Thingport",
  "size": {
    "w": 3,
    "h": 2,
    "minW": 2,
    "minH": 2
  },
  "settings": [
    {
      "key": "title",
      "type": "text",
      "label": "Title",
      "default": "New year"
    },
    {
      "key": "date",
      "type": "text",
      "label": "Date",
      "placeholder": "2027-01-01T00:00",
      "default": "2027-01-01T00:00"
    },
    {
      "key": "showSeconds",
      "type": "toggle",
      "label": "Show seconds",
      "default": false
    }
  ]
}
