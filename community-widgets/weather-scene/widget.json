{
  "name": "Weather scene",
  "description": "Current weather from Open-Meteo, drawn as an animated field, forest, mountains or city that follows the weather, the time of day and the season.",
  "iconUrl": "builtin:thingport/weather",
  "version": "1.2.0",
  "author": "Dante D.",
  "size": {
    "w": 4,
    "h": 3,
    "minW": 2,
    "minH": 2
  },
  "settings": [
    {
      "key": "location",
      "type": "text",
      "label": "settings.location",
      "default": "Vilnius",
      "placeholder": "settings.locationHint"
    },
    {
      "key": "label",
      "type": "text",
      "label": "settings.name",
      "placeholder": "settings.nameHint"
    },
    {
      "key": "units",
      "type": "choice",
      "label": "settings.units",
      "default": "metric",
      "options": [
        {
          "value": "metric",
          "label": "settings.metric"
        },
        {
          "value": "imperial",
          "label": "settings.imperial"
        }
      ]
    },
    {
      "key": "refresh",
      "type": "choice",
      "label": "settings.refresh",
      "default": "30",
      "options": [
        {
          "value": "15",
          "label": "settings.every15"
        },
        {
          "value": "30",
          "label": "settings.every30"
        },
        {
          "value": "60",
          "label": "settings.every60"
        }
      ]
    },
    {
      "key": "details",
      "type": "toggle",
      "label": "settings.details",
      "default": true
    },
    {
      "key": "landscape",
      "type": "choice",
      "label": "settings.landscape",
      "default": "field",
      "options": [
        {
          "value": "field",
          "label": "settings.field"
        },
        {
          "value": "forest",
          "label": "settings.forest"
        },
        {
          "value": "mountains",
          "label": "settings.mountains"
        },
        {
          "value": "city",
          "label": "settings.city"
        },
        {
          "value": "random",
          "label": "settings.random"
        }
      ]
    },
    {
      "key": "events",
      "type": "toggle",
      "label": "settings.events",
      "default": true
    },
    {
      "key": "scene",
      "type": "choice",
      "label": "settings.scene",
      "default": "live",
      "options": [
        {
          "value": "live",
          "label": "settings.live"
        },
        {
          "value": "clear",
          "label": "code.clear"
        },
        {
          "value": "partly",
          "label": "code.partly"
        },
        {
          "value": "overcast",
          "label": "code.overcast"
        },
        {
          "value": "rain",
          "label": "code.rain"
        },
        {
          "value": "snow",
          "label": "code.snow"
        },
        {
          "value": "storm",
          "label": "code.storm"
        },
        {
          "value": "fog",
          "label": "code.fog"
        }
      ]
    },
    {
      "key": "time",
      "type": "choice",
      "label": "settings.time",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "settings.live"
        },
        {
          "value": "dawn",
          "label": "settings.dawn"
        },
        {
          "value": "day",
          "label": "settings.day"
        },
        {
          "value": "dusk",
          "label": "settings.dusk"
        },
        {
          "value": "night",
          "label": "settings.night"
        }
      ]
    },
    {
      "key": "season",
      "type": "choice",
      "label": "settings.season",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "settings.live"
        },
        {
          "value": "spring",
          "label": "settings.spring"
        },
        {
          "value": "summer",
          "label": "settings.summer"
        },
        {
          "value": "autumn",
          "label": "settings.autumn"
        },
        {
          "value": "winter",
          "label": "settings.winter"
        }
      ]
    }
  ],
  "hosts": ["api.open-meteo.com", "geocoding-api.open-meteo.com"],
  "locales": ["en", "lt", "es", "fr"],
  "screenshots": [
    {
      "file": "screenshots/day.webp",
      "caption": "A clear summer afternoon in the field: the sun on its arc, drifting clouds, and the temperature with today's high and low."
    },
    {
      "file": "screenshots/forest.webp",
      "caption": "The forest in autumn, with deer running between the trees."
    },
    {
      "file": "screenshots/mountains.webp",
      "caption": "Mountains on a snowy winter day: pines dusted white under the peaks."
    },
    {
      "file": "screenshots/city.webp",
      "caption": "The city at night: lit windows and street lamps, and a car with its headlights on."
    },
    {
      "file": "screenshots/night.webp",
      "caption": "The field at night in winter: stars, the moon at its phase, snow falling and bare trees."
    },
    {
      "file": "screenshots/storm.webp",
      "caption": "A thunderstorm, drawn from the live weather, with wind and humidity shown."
    }
  ]
}
