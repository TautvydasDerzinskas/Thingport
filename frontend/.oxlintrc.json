{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "no-await-in-loop": "off",
    "react-in-jsx-scope": "off",
    "jsx-no-new-function-as-prop": "off",
    "jsx-no-new-object-as-prop": "off",
    "jsx-no-jsx-as-prop": "off",
    "jsx-no-new-array-as-prop": "off",
    "set-state-in-effect": "off",
    "incompatible-library": "off",
    "consistent-function-scoping": "off"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "node_modules", "coverage"]
}
